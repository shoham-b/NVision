{
  "version": 1,
  "traces": {
    "true_signal": {
      "name": "true signal",
      "mode": "lines",
      "line": { "color": "blue" }
    },
    "noisy_signal": {
      "name": "simulated noisy signal (over-frequency)",
      "mode": "lines",
      "line": { "color": "orange", "dash": "dot" }
    },
    "noisy_band_lo2": {
      "mode": "lines",
      "line": { "width": 0, "color": "rgba(31,119,180,0)" },
      "showlegend": false,
      "hoverinfo": "skip"
    },
    "noisy_band_hi2": {
      "name": "measurement range (±2σ)",
      "mode": "lines",
      "line": { "width": 0, "color": "rgba(31,119,180,0)" },
      "fill": "tonexty",
      "fillcolor": "rgba(31,119,180,0.12)",
      "hoverinfo": "skip"
    },
    "noisy_band_lo": {
      "mode": "lines",
      "line": { "width": 0, "color": "rgba(31,119,180,0)" },
      "showlegend": false,
      "hoverinfo": "skip"
    },
    "noisy_band_hi": {
      "name": "measurement range (±1σ)",
      "mode": "lines",
      "line": { "width": 0, "color": "rgba(31,119,180,0)" },
      "fill": "tonexty",
      "fillcolor": "rgba(31,119,180,0.28)",
      "hoverinfo": "skip"
    },
    "meas_dist_baseline": {
      "mode": "lines",
      "line": { "width": 0, "color": "rgba(111,66,193,0)" },
      "showlegend": false,
      "hoverinfo": "skip"
    },
    "meas_dist": {
      "name": "measurement distribution",
      "visible": "legendonly",
      "mode": "lines",
      "line": { "color": "rgba(111,66,193,0.95)", "width": 1.5 },
      "fill": "tonexty",
      "fillcolor": "rgba(111,66,193,0.30)"
    },
    "coarse": {
      "name": "measurements (coarse)",
      "mode": "markers",
      "marker": { "size": 7, "color": "rgba(176,176,176,0.95)", "line": { "width": 0.6, "color": "#4a4a4a" } }
    },
    "secondary": {
      "name": "measurements (secondary)",
      "mode": "markers",
      "marker": { "size": 7, "color": "rgba(255,127,14,0.9)", "line": { "width": 0.6, "color": "#8B4513" } }
    },
    "tertiary": {
      "name": "measurements (tertiary)",
      "mode": "markers",
      "marker": { "size": 7, "color": "rgba(148,0,211,0.9)", "line": { "width": 0.6, "color": "#4B0082" } }
    },
    "inference": {
      "name": "measurements (inference)",
      "mode": "markers",
      "marker": { "size": 8, "colorscale": "Viridis", "showscale": true, "line": { "width": 0.5, "color": "black" } }
    },
    "steps_noisy": {
      "name": "measurements (noisy)",
      "mode": "markers",
      "marker": { "size": 8, "colorscale": "Viridis", "showscale": true, "line": { "width": 0.5, "color": "black" } }
    },
    "mode_signal": {
      "name": "locator most likely signal",
      "mode": "lines",
      "line": { "color": "#d62728", "width": 2, "dash": "dash" }
    },
    "sobol_meas": {
      "name": "sobol measurements (noisy)",
      "mode": "markers",
      "visible": "legendonly",
      "marker": { "size": 6, "color": "rgba(100, 116, 139, 0.4)", "line": { "width": 0.8, "color": "rgba(30, 41, 59, 0.7)" } }
    },
    "sobol_mode": {
      "name": "sobol most likely signal",
      "mode": "lines",
      "visible": "legendonly",
      "line": { "color": "#805ad5", "width": 2, "dash": "dashdot" }
    },
    "sweep_meas": {
      "name": "simple sweep measurements (noisy)",
      "mode": "markers",
      "visible": "legendonly",
      "marker": { "size": 6, "color": "rgba(234, 88, 12, 0.4)", "line": { "width": 0.8, "color": "rgba(154, 52, 18, 0.7)" } }
    },
    "sweep_mode": {
      "name": "simple sweep most likely signal",
      "mode": "lines",
      "visible": "legendonly",
      "line": { "color": "#ea580c", "width": 2, "dash": "dashdot" }
    },
    "entropy": {
      "name": "Entropy",
      "mode": "lines+markers",
      "line": { "color": "red" }
    },
    "uncertainty": {
      "name": "Uncertainty",
      "mode": "lines+markers",
      "line": { "color": "green" }
    }
  },
  "layout": {
    "with_metrics": {
      "title": { "text": "Scan with sampled measurements" },
      "template": "plotly_white",
      "height": 800,
      "xaxis": { "title": { "text": "frequency" }, "tickformat": "~s", "domain": [0, 1], "anchor": "y" },
      "yaxis": { "title": { "text": "intensity" }, "domain": [0.405, 1.0], "anchor": "x" },
      "xaxis2": { "title": { "text": "step" }, "domain": [0, 1], "anchor": "y2" },
      "yaxis2": { "title": { "text": "metric value" }, "domain": [0, 0.255], "anchor": "x2" },
      "legend": { "orientation": "h", "yanchor": "bottom", "y": 1.02, "xanchor": "right", "x": 1 },
      "annotations": [
        { "text": "Scan Measurements", "showarrow": false, "x": 0.5, "xref": "paper", "y": 1.0, "yref": "paper", "yanchor": "bottom", "xanchor": "center", "font": { "size": 14 } },
        { "text": "Convergence Metrics", "showarrow": false, "x": 0.5, "xref": "paper", "y": 0.255, "yref": "paper", "yanchor": "bottom", "xanchor": "center", "font": { "size": 14 } }
      ]
    },
    "no_metrics": {
      "title": { "text": "Scan with sampled measurements" },
      "template": "plotly_white",
      "margin": { "t": 110 },
      "xaxis": { "title": { "text": "frequency" }, "tickformat": "~s" },
      "yaxis": { "title": { "text": "intensity (photon count)" } },
      "legend": { "orientation": "h", "yanchor": "bottom", "y": 1.02, "xanchor": "left", "x": 0.0 }
    }
  },
  "focus_window_style": {
    "fillcolor": "rgba(46, 204, 113, 0.16)",
    "line_color": "rgba(46, 204, 113, 0.7)",
    "annotation": "Bayesian focus area"
  },
  "per_dip_colors": [
    { "fill": "rgba(255, 159, 64, 0.20)", "line": "rgba(255, 159, 64, 0.8)" },
    { "fill": "rgba(153, 102, 255, 0.20)", "line": "rgba(153, 102, 255, 0.8)" },
    { "fill": "rgba(54, 162, 235, 0.20)", "line": "rgba(54, 162, 235, 0.8)" }
  ],
  "center_freq_style": {
    "line_color": "green",
    "annotation": "true center frequency"
  }
}
