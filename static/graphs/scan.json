{
  "version": 1,
  "traces": {
    "true_signal": {
      "type": "scatter",
      "mode": "lines",
      "name": "True signal",
      "line": { "color": "#1f77b4", "width": 2 }
    },
    "noisy_signal": {
      "type": "scatter",
      "mode": "lines",
      "name": "Noisy signal",
      "line": { "color": "#7f7f7f", "width": 1, "dash": "dot" },
      "opacity": 0.6
    },
    "noisy_band_lo2": {
      "type": "scatter",
      "mode": "lines",
      "name": "±2σ range",
      "line": { "width": 0 },
      "showlegend": false,
      "hoverinfo": "skip"
    },
    "noisy_band_hi2": {
      "type": "scatter",
      "mode": "lines",
      "name": "±2σ range",
      "line": { "width": 0 },
      "fill": "tonexty",
      "fillcolor": "rgba(31,119,180,0.10)",
      "hoverinfo": "skip"
    },
    "noisy_band_lo": {
      "type": "scatter",
      "mode": "lines",
      "name": "±1σ range",
      "line": { "width": 0 },
      "showlegend": false,
      "hoverinfo": "skip"
    },
    "noisy_band_hi": {
      "type": "scatter",
      "mode": "lines",
      "name": "±1σ range",
      "line": { "width": 0 },
      "fill": "tonexty",
      "fillcolor": "rgba(31,119,180,0.22)",
      "hoverinfo": "skip"
    },
    "meas_dist_baseline": {
      "type": "scatter",
      "mode": "lines",
      "name": "baseline",
      "line": { "color": "#7f7f7f", "width": 1 },
      "showlegend": false,
      "hoverinfo": "skip"
    },
    "meas_dist": {
      "type": "scatter",
      "mode": "lines",
      "name": "Measurement density",
      "fill": "tonexty",
      "fillcolor": "rgba(255,127,14,0.30)",
      "line": { "color": "rgba(255,127,14,0.6)", "width": 1 },
      "hovertemplate": "%{customdata:.1f}%<extra></extra>"
    },
    "coarse": {
      "type": "scatter",
      "mode": "markers",
      "name": "Coarse sweep",
      "marker": { "color": "#2ca02c", "size": 6, "symbol": "circle" },
      "hovertemplate": "depth: %{customdata:.1f}%<extra></extra>"
    },
    "secondary": {
      "type": "scatter",
      "mode": "markers",
      "name": "Secondary sweep",
      "marker": { "color": "#9467bd", "size": 6, "symbol": "diamond" },
      "hovertemplate": "depth: %{customdata:.1f}%<extra></extra>"
    },
    "tertiary": {
      "type": "scatter",
      "mode": "markers",
      "name": "Tertiary sweep",
      "marker": { "color": "#8c564b", "size": 6, "symbol": "square" },
      "hovertemplate": "depth: %{customdata:.1f}%<extra></extra>"
    },
    "inference": {
      "type": "scatter",
      "mode": "markers",
      "name": "Inference measurements",
      "marker": {
        "size": 7,
        "symbol": "circle",
        "colorscale": "Viridis",
        "showscale": true
      },
      "hovertemplate": "depth: %{customdata:.1f}%<extra></extra>"
    },
    "steps_noisy": {
      "type": "scatter",
      "mode": "markers",
      "name": "Measurements",
      "marker": {
        "size": 7,
        "symbol": "circle",
        "colorscale": "Viridis",
        "showscale": true
      },
      "hovertemplate": "depth: %{customdata:.1f}%<extra></extra>"
    },
    "mode_signal": {
      "type": "scatter",
      "mode": "lines",
      "name": "MAP estimate",
      "line": { "color": "#d62728", "width": 2, "dash": "dash" }
    },
    "sobol_meas": {
      "type": "scatter",
      "mode": "markers",
      "name": "Sobol measurements",
      "marker": { "color": "#17becf", "size": 6, "symbol": "x" },
      "hovertemplate": "depth: %{customdata:.1f}%<extra></extra>"
    },
    "sobol_mode": {
      "type": "scatter",
      "mode": "lines",
      "name": "Sobol estimate",
      "line": { "color": "#17becf", "width": 2, "dash": "dot" }
    },
    "sweep_meas": {
      "type": "scatter",
      "mode": "markers",
      "name": "Sweep measurements",
      "marker": { "color": "#bcbd22", "size": 6, "symbol": "triangle-up" },
      "hovertemplate": "depth: %{customdata:.1f}%<extra></extra>"
    },
    "sweep_mode": {
      "type": "scatter",
      "mode": "lines",
      "name": "Sweep estimate",
      "line": { "color": "#bcbd22", "width": 2, "dash": "dot" }
    },
    "entropy": {
      "type": "scatter",
      "mode": "lines+markers",
      "name": "Entropy",
      "line": { "color": "#e377c2", "width": 1.5 },
      "marker": { "size": 4 }
    },
    "uncertainty": {
      "type": "scatter",
      "mode": "lines+markers",
      "name": "Uncertainty",
      "line": { "color": "#7f7f7f", "width": 1.5 },
      "marker": { "size": 4 }
    }
  },
  "layout": {
    "no_metrics": {
      "autosize": true,
      "height": 420,
      "margin": { "t": 40, "r": 20, "b": 40, "l": 60 },
      "xaxis": { "title": { "text": "Frequency (Hz)" } },
      "yaxis": { "title": { "text": "Signal" } },
      "legend": { "orientation": "h" },
      "hovermode": "closest"
    },
    "with_metrics": {
      "autosize": true,
      "height": 620,
      "margin": { "t": 40, "r": 20, "b": 40, "l": 60 },
      "xaxis": {
        "title": { "text": "Frequency (Hz)" },
        "domain": [0, 1],
        "anchor": "y"
      },
      "yaxis": { "title": { "text": "Signal" }, "domain": [0.45, 1] },
      "xaxis2": {
        "title": { "text": "Step" },
        "domain": [0, 1],
        "anchor": "y2"
      },
      "yaxis2": { "title": { "text": "Entropy" }, "domain": [0, 0.35] },
      "yaxis3": {
        "title": { "text": "Uncertainty" },
        "overlaying": "y2",
        "side": "right"
      },
      "legend": { "orientation": "h" },
      "hovermode": "closest"
    }
  },
  "focus_window_style": {
    "fillcolor": "rgba(255,193,7,0.15)",
    "line_color": "rgba(255,193,7,0.6)",
    "annotation": "focus window"
  },
  "per_dip_colors": [
    { "fill": "rgba(31,119,180,0.12)", "line": "rgba(31,119,180,0.4)" },
    { "fill": "rgba(255,127,14,0.12)", "line": "rgba(255,127,14,0.4)" },
    { "fill": "rgba(44,160,44,0.12)", "line": "rgba(44,160,44,0.4)" },
    { "fill": "rgba(214,39,40,0.12)", "line": "rgba(214,39,40,0.4)" }
  ],
  "center_freq_style": {
    "line_color": "#d62728",
    "annotation": "true center"
  }
}
