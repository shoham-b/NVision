{
    "version": 1,
    "traces": {
        "true_signal": {
            "type": "scatter",
            "mode": "lines",
            "name": "True signal",
            "line": { "color": "#111111", "width": 2 },
            "hoverinfo": "skip"
        },
        "noisy_band_lo2": {
            "type": "scatter",
            "mode": "lines",
            "name": "±2σ range",
            "line": { "width": 0 },
            "showlegend": false,
            "hoverinfo": "skip"
        },
        "noisy_band_hi2": {
            "type": "scatter",
            "mode": "lines",
            "name": "±2σ range",
            "line": { "width": 0 },
            "fill": "tonexty",
            "fillcolor": "rgba(0,86,179,0.08)",
            "hoverinfo": "skip"
        },
        "noisy_band_lo": {
            "type": "scatter",
            "mode": "lines",
            "name": "±1σ range",
            "line": { "width": 0 },
            "showlegend": false,
            "hoverinfo": "skip"
        },
        "noisy_band_hi": {
            "type": "scatter",
            "mode": "lines",
            "name": "±1σ range",
            "line": { "width": 0 },
            "fill": "tonexty",
            "fillcolor": "rgba(0,86,179,0.18)",
            "hoverinfo": "skip"
        },
        "noisy_signal": {
            "type": "scatter",
            "mode": "lines",
            "name": "Noisy signal",
            "line": { "color": "#0056b3", "width": 1, "dash": "dot" },
            "hoverinfo": "skip"
        },
        "meas_dist_baseline": {
            "type": "scatter",
            "mode": "lines",
            "name": "Measurement density",
            "line": { "color": "#999999", "width": 1 },
            "showlegend": false,
            "hoverinfo": "skip"
        },
        "meas_dist": {
            "type": "scatter",
            "mode": "lines",
            "name": "Measurement density",
            "line": { "color": "#999999", "width": 1 },
            "fill": "tonexty",
            "fillcolor": "rgba(150,150,150,0.25)",
            "hoverinfo": "skip"
        },
        "coarse": {
            "type": "scatter",
            "mode": "markers",
            "name": "Coarse phase",
            "marker": { "color": "#f4a300", "size": 7, "symbol": "diamond" },
            "hovertemplate": "x=%{x}<br>y=%{y}<br>depth=%{customdata:.1f}%<extra>Coarse phase</extra>"
        },
        "secondary": {
            "type": "scatter",
            "mode": "markers",
            "name": "Secondary phase",
            "marker": { "color": "#e8590c", "size": 7, "symbol": "square" },
            "hovertemplate": "x=%{x}<br>y=%{y}<br>depth=%{customdata:.1f}%<extra>Secondary phase</extra>"
        },
        "tertiary": {
            "type": "scatter",
            "mode": "markers",
            "name": "Tertiary phase",
            "marker": { "color": "#c92a2a", "size": 7, "symbol": "triangle-up" },
            "hovertemplate": "x=%{x}<br>y=%{y}<br>depth=%{customdata:.1f}%<extra>Tertiary phase</extra>"
        },
        "inference": {
            "type": "scatter",
            "mode": "markers",
            "name": "Inference phase",
            "marker": {
                "size": 6,
                "colorscale": "Viridis",
                "showscale": true
            },
            "hovertemplate": "x=%{x}<br>y=%{y}<br>depth=%{customdata:.1f}%<extra>Inference phase</extra>"
        },
        "steps_noisy": {
            "type": "scatter",
            "mode": "markers",
            "name": "Measurements",
            "marker": {
                "size": 6,
                "colorscale": "Viridis",
                "showscale": true
            },
            "hovertemplate": "x=%{x}<br>y=%{y}<br>depth=%{customdata:.1f}%<extra>Measurements</extra>"
        },
        "mode_signal": {
            "type": "scatter",
            "mode": "lines",
            "name": "MAP estimate",
            "line": { "color": "#d6336c", "width": 2, "dash": "dash" }
        },
        "sobol_meas": {
            "type": "scatter",
            "mode": "markers",
            "name": "Sobol measurements",
            "marker": { "color": "#12b886", "size": 6, "symbol": "x" },
            "hovertemplate": "x=%{x}<br>y=%{y}<br>depth=%{customdata:.1f}%<extra>Sobol measurements</extra>"
        },
        "sobol_mode": {
            "type": "scatter",
            "mode": "lines",
            "name": "Sobol estimate",
            "line": { "color": "#12b886", "width": 2, "dash": "dot" }
        },
        "sweep_meas": {
            "type": "scatter",
            "mode": "markers",
            "name": "Sweep measurements",
            "marker": { "color": "#7048e8", "size": 6, "symbol": "cross" },
            "hovertemplate": "x=%{x}<br>y=%{y}<br>depth=%{customdata:.1f}%<extra>Sweep measurements</extra>"
        },
        "sweep_mode": {
            "type": "scatter",
            "mode": "lines",
            "name": "Sweep estimate",
            "line": { "color": "#7048e8", "width": 2, "dash": "dashdot" }
        },
        "entropy": {
            "type": "scatter",
            "mode": "lines",
            "name": "Entropy",
            "line": { "color": "#0056b3", "width": 2 }
        },
        "uncertainty": {
            "type": "scatter",
            "mode": "lines",
            "name": "Uncertainty",
            "line": { "color": "#e8590c", "width": 2 }
        }
    },
    "layout": {
        "no_metrics": {
            "xaxis": { "title": { "text": "Frequency" } },
            "yaxis": { "title": { "text": "Signal" } },
            "legend": { "orientation": "h", "y": -0.2 },
            "margin": { "t": 40, "r": 40, "b": 60, "l": 60 },
            "hovermode": "closest"
        },
        "with_metrics": {
            "xaxis": { "title": { "text": "Frequency" }, "domain": [0, 1], "anchor": "y" },
            "yaxis": { "title": { "text": "Signal" }, "domain": [0.42, 1] },
            "xaxis2": { "title": { "text": "Step" }, "domain": [0, 1], "anchor": "y2" },
            "yaxis2": { "title": { "text": "Entropy" }, "domain": [0, 0.32] },
            "yaxis3": {
                "title": { "text": "Uncertainty" },
                "domain": [0, 0.32],
                "overlaying": "y2",
                "side": "right"
            },
            "legend": { "orientation": "h", "y": -0.15 },
            "margin": { "t": 40, "r": 60, "b": 60, "l": 60 },
            "hovermode": "closest"
        }
    },
    "focus_window_style": {
        "fillcolor": "rgba(0,86,179,0.08)",
        "line_color": "#0056b3",
        "annotation": "Focus window"
    },
    "per_dip_colors": [
        { "fill": "rgba(232,89,12,0.10)", "line": "#e8590c" },
        { "fill": "rgba(18,184,134,0.10)", "line": "#12b886" },
        { "fill": "rgba(112,72,232,0.10)", "line": "#7048e8" },
        { "fill": "rgba(201,42,42,0.10)", "line": "#c92a2a" }
    ],
    "center_freq_style": {
        "line_color": "#111111",
        "annotation": "True center"
    }
}
