{
  "version": 1,
  "layout": {
    "with_metrics": {
      "xaxis": {
        "anchor": "y",
        "domain": [
          0.0,
          1.0
        ],
        "title": {
          "text": "frequency"
        },
        "tickformat": "~s"
      },
      "yaxis": {
        "anchor": "x",
        "domain": [
          0.405,
          1.0
        ],
        "title": {
          "text": "intensity"
        }
      },
      "xaxis2": {
        "anchor": "y2",
        "domain": [
          0.0,
          1.0
        ],
        "title": {
          "text": "step"
        }
      },
      "yaxis2": {
        "anchor": "x2",
        "domain": [
          0.0,
          0.255
        ],
        "title": {
          "text": "metric value"
        }
      },
      "annotations": [
        {
          "font": {
            "size": 16
          },
          "showarrow": false,
          "text": "Scan Measurements",
          "x": 0.5,
          "xanchor": "center",
          "xref": "paper",
          "y": 1.0,
          "yanchor": "bottom",
          "yref": "paper"
        },
        {
          "font": {
            "size": 16
          },
          "showarrow": false,
          "text": "Convergence Metrics",
          "x": 0.5,
          "xanchor": "center",
          "xref": "paper",
          "y": 0.255,
          "yanchor": "bottom",
          "yref": "paper"
        }
      ],
      "legend": {
        "orientation": "h",
        "yanchor": "bottom",
        "y": 1.02,
        "xanchor": "right",
        "x": 1
      },
      "title": {
        "text": "Scan with sampled measurements"
      },
      "height": 800,
      "yaxis3": {
        "overlaying": "y2",
        "side": "right",
        "anchor": "x2",
        "title": {
          "text": "Uncertainty"
        }
      }
    },
    "no_metrics": {
      "xaxis": {
        "title": {
          "text": "frequency"
        },
        "tickformat": "~s"
      },
      "legend": {
        "orientation": "h",
        "yanchor": "bottom",
        "y": 1.02,
        "xanchor": "left",
        "x": 0.0
      },
      "margin": {
        "t": 110
      },
      "title": {
        "text": "Scan with sampled measurements"
      },
      "yaxis": {
        "title": {
          "text": "intensity (photon count)"
        }
      }
    }
  },
  "traces": {
    "true_signal": {
      "type": "scatter",
      "mode": "lines",
      "name": "true signal",
      "line": {
        "color": "blue"
      }
    },
    "noisy_signal": {
      "type": "scatter",
      "mode": "lines",
      "name": "simulated noisy signal (over-frequency)",
      "line": {
        "color": "orange",
        "dash": "dot"
      }
    },
    "noisy_band_lo2": {
      "type": "scatter",
      "mode": "lines",
      "line": {
        "width": 0,
        "color": "rgba(100,100,100,0)"
      },
      "showlegend": false,
      "hoverinfo": "skip"
    },
    "noisy_band_hi2": {
      "type": "scatter",
      "mode": "lines",
      "name": "possible measurement range (\u00b12\u03c3)",
      "line": {
        "width": 0,
        "color": "rgba(100,100,100,0)"
      },
      "fill": "tonexty",
      "fillcolor": "rgba(100,100,100,0.15)"
    },
    "noisy_band_lo": {
      "type": "scatter",
      "mode": "lines",
      "line": {
        "width": 0,
        "color": "rgba(100,100,100,0)"
      },
      "showlegend": false,
      "hoverinfo": "skip"
    },
    "noisy_band_hi": {
      "type": "scatter",
      "mode": "lines",
      "name": "possible measurement range (\u00b11\u03c3)",
      "line": {
        "width": 0,
        "color": "rgba(100,100,100,0)"
      },
      "fill": "tonexty",
      "fillcolor": "rgba(100,100,100,0.30)"
    },
    "meas_dist_baseline": {
      "type": "scatter",
      "mode": "lines",
      "line": {
        "width": 0,
        "color": "rgba(111,66,193,0)"
      },
      "showlegend": false,
      "hoverinfo": "skip"
    },
    "meas_dist": {
      "type": "scatter",
      "mode": "lines",
      "name": "measurement distribution",
      "visible": "legendonly",
      "line": {
        "color": "rgba(111,66,193,0.95)",
        "width": 1.5
      },
      "fill": "tonexty",
      "fillcolor": "rgba(111,66,193,0.30)",
      "hovertemplate": "x=%{x}<br>relative density=%{customdata:.1f}%<extra></extra>"
    },
    "coarse": {
      "type": "scatter",
      "mode": "markers",
      "name": "measurements (coarse)",
      "marker": {
        "size": 7,
        "color": "rgba(176,176,176,0.95)",
        "line": {
          "width": 0.6,
          "color": "#4a4a4a"
        }
      },
      "hovertemplate": "x=%{x}<br>y=%{y:.4f}<br>down=%{customdata:.1f}%<extra></extra>"
    },
    "secondary": {
      "type": "scatter",
      "mode": "markers",
      "name": "measurements (secondary)",
      "marker": {
        "size": 7,
        "color": "rgba(255,127,14,0.9)",
        "line": {
          "width": 0.6,
          "color": "#8B4513"
        }
      },
      "hovertemplate": "x=%{x}<br>y=%{y:.4f}<br>down=%{customdata:.1f}%<extra></extra>"
    },
    "tertiary": {
      "type": "scatter",
      "mode": "markers",
      "name": "measurements (tertiary)",
      "marker": {
        "size": 7,
        "color": "rgba(148,0,211,0.9)",
        "line": {
          "width": 0.6,
          "color": "#4B0082"
        }
      },
      "hovertemplate": "x=%{x}<br>y=%{y:.4f}<br>down=%{customdata:.1f}%<extra></extra>"
    },
    "inference": {
      "type": "scatter",
      "mode": "markers",
      "name": "measurements (inference)",
      "marker": {
        "size": 8,
        "colorscale": "Viridis",
        "showscale": true,
        "line": {
          "width": 0.5,
          "color": "black"
        },
        "colorbar": {
          "title": {
            "text": "inference step"
          }
        }
      },
      "hovertemplate": "x=%{x}<br>y=%{y:.4f}<br>down=%{customdata:.1f}%<extra></extra>"
    },
    "steps_noisy": {
      "type": "scatter",
      "mode": "markers",
      "name": "measurements (noisy)",
      "marker": {
        "size": 8,
        "colorscale": "Viridis",
        "showscale": true,
        "line": {
          "width": 0.5,
          "color": "black"
        },
        "colorbar": {
          "title": {
            "text": "step"
          }
        }
      },
      "hovertemplate": "x=%{x}<br>y=%{y:.4f}<br>down=%{customdata:.1f}%<br>step=%{marker.color}<extra></extra>"
    },
    "mode_signal": {
      "type": "scatter",
      "mode": "lines",
      "name": "locator most likely signal",
      "line": {
        "color": "#d62728",
        "width": 2,
        "dash": "dash"
      }
    },
    "sobol_meas": {
      "type": "scatter",
      "mode": "markers",
      "name": "sobol measurements (noisy)",
      "marker": {
        "size": 7,
        "color": "rgba(23,162,184,0.85)",
        "symbol": "circle",
        "line": {
          "width": 0.6,
          "color": "#0f6674"
        }
      },
      "hovertemplate": "x=%{x}<br>y=%{y:.4f}<br>down=%{customdata:.1f}%<extra></extra>"
    },
    "sobol_mode": {
      "type": "scatter",
      "mode": "lines",
      "name": "sobol most likely signal",
      "line": {
        "color": "#17a2b8",
        "width": 2,
        "dash": "dashdot"
      }
    },
    "sweep_meas": {
      "type": "scatter",
      "mode": "markers",
      "name": "sweep measurements (noisy)",
      "marker": {
        "size": 7,
        "color": "rgba(133,100,4,0.85)",
        "symbol": "diamond",
        "line": {
          "width": 0.6,
          "color": "#5c4404"
        }
      },
      "hovertemplate": "x=%{x}<br>y=%{y:.4f}<br>down=%{customdata:.1f}%<extra></extra>"
    },
    "sweep_mode": {
      "type": "scatter",
      "mode": "lines",
      "name": "sweep most likely signal",
      "line": {
        "color": "#856404",
        "width": 2,
        "dash": "dashdot"
      }
    },
    "entropy": {
      "type": "scatter",
      "mode": "lines+markers",
      "name": "Entropy",
      "line": {
        "color": "red"
      }
    },
    "uncertainty": {
      "type": "scatter",
      "mode": "lines+markers",
      "name": "Uncertainty",
      "line": {
        "color": "green"
      }
    }
  },
  "focus_window_style": {
    "fillcolor": "rgba(46, 204, 113, 0.16)",
    "line_color": "rgba(46, 204, 113, 0.7)",
    "annotation": "Bayesian focus area"
  },
  "per_dip_colors": [
    {
      "fill": "rgba(255, 159, 64, 0.20)",
      "line": "rgba(255, 159, 64, 0.8)"
    },
    {
      "fill": "rgba(153, 102, 255, 0.20)",
      "line": "rgba(153, 102, 255, 0.8)"
    },
    {
      "fill": "rgba(54, 162, 235, 0.20)",
      "line": "rgba(54, 162, 235, 0.8)"
    }
  ],
  "center_freq_style": {
    "line_color": "green",
    "annotation": "true frequency"
  }
}