{
    "version": 1,
    "traces": {
        "true_signal": {
            "type": "scatter",
            "mode": "lines",
            "name": "True signal",
            "line": { "color": "#333333", "width": 1.5 }
        },
        "noisy_band_lo2": {
            "type": "scatter",
            "mode": "lines",
            "name": "±2σ range",
            "showlegend": false,
            "hoverinfo": "skip",
            "line": { "width": 0 }
        },
        "noisy_band_hi2": {
            "type": "scatter",
            "mode": "lines",
            "name": "±2σ range",
            "hoverinfo": "skip",
            "line": { "width": 0 },
            "fill": "tonexty",
            "fillcolor": "rgba(0, 86, 179, 0.08)"
        },
        "noisy_band_lo": {
            "type": "scatter",
            "mode": "lines",
            "name": "±1σ range",
            "showlegend": false,
            "hoverinfo": "skip",
            "line": { "width": 0 }
        },
        "noisy_band_hi": {
            "type": "scatter",
            "mode": "lines",
            "name": "±1σ range",
            "hoverinfo": "skip",
            "line": { "width": 0 },
            "fill": "tonexty",
            "fillcolor": "rgba(0, 86, 179, 0.18)"
        },
        "noisy_signal": {
            "type": "scatter",
            "mode": "lines",
            "name": "Noisy signal",
            "line": { "color": "#888888", "width": 1, "dash": "dot" }
        },
        "meas_dist_baseline": {
            "type": "scatter",
            "mode": "lines",
            "name": "Baseline",
            "showlegend": false,
            "hoverinfo": "skip",
            "line": { "color": "#aaaaaa", "width": 1, "dash": "dash" }
        },
        "meas_dist": {
            "type": "scatter",
            "mode": "lines",
            "name": "Measurement density",
            "fill": "tonexty",
            "fillcolor": "rgba(25, 135, 84, 0.25)",
            "line": { "color": "#198754", "width": 1 }
        },
        "coarse": {
            "type": "scatter",
            "mode": "markers",
            "name": "Coarse scan",
            "marker": { "color": "#6c757d", "size": 9, "symbol": "circle" }
        },
        "secondary": {
            "type": "scatter",
            "mode": "markers",
            "name": "Secondary scan",
            "marker": { "color": "#0d6efd", "size": 7, "symbol": "diamond" }
        },
        "tertiary": {
            "type": "scatter",
            "mode": "markers",
            "name": "Tertiary scan",
            "marker": { "color": "#6610f2", "size": 6, "symbol": "square" }
        },
        "inference": {
            "type": "scatter",
            "mode": "markers",
            "name": "Fine measurements",
            "marker": { "size": 6, "colorscale": "Viridis", "showscale": true }
        },
        "steps_noisy": {
            "type": "scatter",
            "mode": "markers",
            "name": "Measurements",
            "marker": { "size": 6, "colorscale": "Viridis", "showscale": true }
        },
        "mode_signal": {
            "type": "scatter",
            "mode": "lines",
            "name": "Estimated signal (MAP)",
            "line": { "color": "#dc3545", "width": 2 }
        },
        "sobol_meas": {
            "type": "scatter",
            "mode": "markers",
            "name": "Sobol measurements",
            "marker": { "color": "#9c27b0", "size": 6, "symbol": "x" }
        },
        "sobol_mode": {
            "type": "scatter",
            "mode": "lines",
            "name": "Sobol estimate",
            "line": { "color": "#9c27b0", "width": 2, "dash": "dash" }
        },
        "sweep_meas": {
            "type": "scatter",
            "mode": "markers",
            "name": "Sweep measurements",
            "marker": { "color": "#fd7e14", "size": 6, "symbol": "triangle-up" }
        },
        "sweep_mode": {
            "type": "scatter",
            "mode": "lines",
            "name": "Sweep estimate",
            "line": { "color": "#fd7e14", "width": 2, "dash": "dash" }
        },
        "entropy": {
            "type": "scatter",
            "mode": "lines",
            "name": "Entropy",
            "line": { "color": "#0dcaf0", "width": 1.5 }
        },
        "uncertainty": {
            "type": "scatter",
            "mode": "lines",
            "name": "Uncertainty",
            "line": { "color": "#fd7e14", "width": 1.5 }
        }
    },
    "layout": {
        "no_metrics": {
            "margin": { "l": 60, "r": 30, "t": 30, "b": 50 },
            "hovermode": "closest",
            "legend": { "orientation": "h", "y": -0.2 },
            "xaxis": { "title": { "text": "Frequency (GHz)" } },
            "yaxis": { "title": { "text": "Signal" } }
        },
        "with_metrics": {
            "margin": { "l": 60, "r": 60, "t": 30, "b": 50 },
            "hovermode": "closest",
            "legend": { "orientation": "h", "y": -0.15 },
            "xaxis": { "title": { "text": "Frequency (GHz)" }, "anchor": "y", "domain": [0, 1] },
            "yaxis": { "title": { "text": "Signal" }, "anchor": "x", "domain": [0.38, 1] },
            "xaxis2": { "title": { "text": "Step" }, "anchor": "y2", "domain": [0, 1] },
            "yaxis2": { "title": { "text": "Entropy" }, "anchor": "x2", "domain": [0, 0.3] },
            "yaxis3": {
                "title": { "text": "Uncertainty" },
                "anchor": "x2",
                "overlaying": "y2",
                "side": "right",
                "domain": [0, 0.3]
            }
        }
    },
    "focus_window_style": {
        "fillcolor": "rgba(255, 193, 7, 0.15)",
        "line_color": "#ffc107",
        "annotation": "Focus window"
    },
    "per_dip_colors": [
        { "fill": "rgba(220, 53, 69, 0.12)", "line": "#dc3545" },
        { "fill": "rgba(13, 110, 253, 0.12)", "line": "#0d6efd" },
        { "fill": "rgba(25, 135, 84, 0.12)", "line": "#198754" },
        { "fill": "rgba(102, 16, 242, 0.12)", "line": "#6610f2" },
        { "fill": "rgba(253, 126, 20, 0.12)", "line": "#fd7e14" }
    ],
    "center_freq_style": {
        "line_color": "#198754",
        "annotation": "True center frequency"
    }
}
