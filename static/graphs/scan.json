{
  "version": 1,
  "traces": {
    "true_signal": {
      "type": "scatter",
      "mode": "lines",
      "name": "true signal",
      "line": { "color": "blue", "width": 2 }
    },
    "noisy_signal": {
      "type": "scatter",
      "mode": "lines",
      "name": "simulated noisy signal (over-frequency)",
      "line": { "color": "orange", "dash": "dot" }
    },
    "noisy_band_lo2": {
      "type": "scatter",
      "mode": "lines",
      "name": "measurement range (±2σ)",
      "line": { "color": "rgba(255,165,0,0)", "width": 0 },
      "showlegend": false,
      "hoverinfo": "skip"
    },
    "noisy_band_hi2": {
      "type": "scatter",
      "mode": "lines",
      "name": "measurement range (±2σ)",
      "line": { "color": "rgba(255,165,0,0)", "width": 0 },
      "fill": "tonexty",
      "fillcolor": "rgba(255,165,0,0.12)",
      "hoverinfo": "skip"
    },
    "noisy_band_lo": {
      "type": "scatter",
      "mode": "lines",
      "name": "measurement range (±1σ)",
      "line": { "color": "rgba(255,165,0,0)", "width": 0 },
      "showlegend": false,
      "hoverinfo": "skip"
    },
    "noisy_band_hi": {
      "type": "scatter",
      "mode": "lines",
      "name": "measurement range (±1σ)",
      "line": { "color": "rgba(255,165,0,0)", "width": 0 },
      "fill": "tonexty",
      "fillcolor": "rgba(255,165,0,0.25)",
      "hoverinfo": "skip"
    },
    "mode_signal": {
      "type": "scatter",
      "mode": "lines",
      "name": "locator most likely signal",
      "line": { "color": "#d62728", "width": 2, "dash": "dash" }
    },
    "coarse": {
      "type": "scatter",
      "mode": "markers",
      "name": "measurements (coarse)",
      "marker": { "size": 7, "color": "rgba(176,176,176,0.95)", "line": { "width": 0.6, "color": "#4a4a4a" } },
      "hovertemplate": "x=%{x}<br>y=%{y:.4f}<br>down=%{customdata:.1f}%<extra></extra>"
    },
    "secondary": {
      "type": "scatter",
      "mode": "markers",
      "name": "measurements (secondary)",
      "marker": { "size": 7, "color": "rgba(255,127,14,0.9)", "line": { "width": 0.6, "color": "#8B4513" } },
      "hovertemplate": "x=%{x}<br>y=%{y:.4f}<br>down=%{customdata:.1f}%<extra></extra>"
    },
    "tertiary": {
      "type": "scatter",
      "mode": "markers",
      "name": "measurements (tertiary)",
      "marker": { "size": 7, "color": "rgba(148,0,211,0.9)", "line": { "width": 0.6, "color": "#4B0082" } },
      "hovertemplate": "x=%{x}<br>y=%{y:.4f}<br>down=%{customdata:.1f}%<extra></extra>"
    },
    "inference": {
      "type": "scatter",
      "mode": "markers",
      "name": "measurements (inference)",
      "marker": { "size": 8, "colorscale": "Viridis", "showscale": true, "line": { "width": 0.5, "color": "black" } },
      "hovertemplate": "x=%{x}<br>y=%{y:.4f}<br>down=%{customdata:.1f}%<extra></extra>"
    },
    "steps_noisy": {
      "type": "scatter",
      "mode": "markers",
      "name": "measurements (noisy)",
      "marker": { "size": 8, "colorscale": "Viridis", "showscale": true, "line": { "width": 0.5, "color": "black" } },
      "hovertemplate": "x=%{x}<br>y=%{y:.4f}<br>down=%{customdata:.1f}%<br>step=%{marker.color}<extra></extra>"
    },
    "meas_dist_baseline": {
      "type": "scatter",
      "mode": "lines",
      "line": { "width": 0, "color": "rgba(111,66,193,0)" },
      "showlegend": false,
      "hoverinfo": "skip"
    },
    "meas_dist": {
      "type": "scatter",
      "mode": "lines",
      "name": "measurement distribution",
      "visible": "legendonly",
      "line": { "color": "rgba(111,66,193,0.95)", "width": 1.5 },
      "fill": "tonexty",
      "fillcolor": "rgba(111,66,193,0.30)",
      "hovertemplate": "x=%{x}<br>relative density=%{customdata:.1f}%<extra></extra>"
    },
    "sobol_meas": {
      "type": "scatter",
      "mode": "markers",
      "name": "measurements (Sobol)",
      "marker": { "size": 7, "color": "rgba(23,190,207,0.9)", "line": { "width": 0.6, "color": "#0b5761" } },
      "hovertemplate": "x=%{x}<br>y=%{y:.4f}<br>down=%{customdata:.1f}%<extra></extra>"
    },
    "sobol_mode": {
      "type": "scatter",
      "mode": "lines",
      "name": "Sobol most likely signal",
      "line": { "color": "#17becf", "width": 2, "dash": "dashdot" }
    },
    "sweep_meas": {
      "type": "scatter",
      "mode": "markers",
      "name": "measurements (sweep)",
      "marker": { "size": 7, "color": "rgba(227,119,194,0.9)", "line": { "width": 0.6, "color": "#7a0e5c" } },
      "hovertemplate": "x=%{x}<br>y=%{y:.4f}<br>down=%{customdata:.1f}%<extra></extra>"
    },
    "sweep_mode": {
      "type": "scatter",
      "mode": "lines",
      "name": "Sweep most likely signal",
      "line": { "color": "#e377c2", "width": 2, "dash": "dashdot" }
    },
    "entropy": {
      "type": "scatter",
      "mode": "lines+markers",
      "name": "Entropy",
      "line": { "color": "red" }
    },
    "uncertainty": {
      "type": "scatter",
      "mode": "lines+markers",
      "name": "Uncertainty",
      "line": { "color": "green" }
    }
  },
  "layout": {
    "no_metrics": {
      "title": { "text": "Scan Measurements" },
      "xaxis": { "title": { "text": "Frequency (Hz)" } },
      "yaxis": { "title": { "text": "Signal" } },
      "legend": { "orientation": "h", "y": -0.2 },
      "margin": { "t": 60, "r": 40, "b": 60, "l": 60 },
      "hovermode": "closest"
    },
    "with_metrics": {
      "xaxis": { "domain": [0, 1], "anchor": "y", "title": { "text": "Frequency (Hz)" } },
      "yaxis": { "domain": [0.38, 1], "anchor": "x", "title": { "text": "Signal" } },
      "xaxis2": { "domain": [0, 1], "anchor": "y2", "title": { "text": "step" } },
      "yaxis2": { "domain": [0, 0.25], "anchor": "x2", "title": { "text": "Entropy" } },
      "yaxis3": { "domain": [0, 0.25], "anchor": "x2", "overlaying": "y2", "side": "right", "title": { "text": "Uncertainty" } },
      "legend": { "orientation": "h", "y": -0.1 },
      "margin": { "t": 40, "r": 60, "b": 50, "l": 60 },
      "hovermode": "closest",
      "annotations": [
        { "text": "Scan Measurements", "xref": "paper", "yref": "paper", "x": 0, "y": 1.0, "xanchor": "left", "yanchor": "bottom", "showarrow": false, "font": { "size": 14 } },
        { "text": "Convergence Metrics", "xref": "paper", "yref": "paper", "x": 0, "y": 0.30, "xanchor": "left", "yanchor": "bottom", "showarrow": false, "font": { "size": 14 } }
      ]
    }
  },
  "focus_window_style": {
    "fillcolor": "rgba(46, 204, 113, 0.16)",
    "line_color": "rgba(46, 204, 113, 0.7)",
    "annotation": "Bayesian focus area"
  },
  "per_dip_colors": [
    { "fill": "rgba(255, 159, 64, 0.20)", "line": "rgba(255, 159, 64, 0.8)" },
    { "fill": "rgba(153, 102, 255, 0.20)", "line": "rgba(153, 102, 255, 0.8)" },
    { "fill": "rgba(54, 162, 235, 0.20)", "line": "rgba(54, 162, 235, 0.8)" }
  ],
  "center_freq_style": {
    "line_color": "#000000",
    "annotation": "True center frequency"
  }
}
