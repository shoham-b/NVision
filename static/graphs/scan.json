{
  "version": 1,
  "traces": {
    "true_signal": {
      "name": "true signal",
      "mode": "lines",
      "line": { "color": "blue" }
    },
    "noisy_band_lo2": {
      "name": "noisy signal (~2σ envelope)",
      "mode": "lines",
      "line": { "width": 0, "color": "rgba(255,165,0,0)" },
      "showlegend": false,
      "hoverinfo": "skip"
    },
    "noisy_band_hi2": {
      "name": "noisy signal (~2σ envelope)",
      "mode": "lines",
      "line": { "width": 0, "color": "rgba(255,165,0,0)" },
      "fill": "tonexty",
      "fillcolor": "rgba(255,165,0,0.15)",
      "showlegend": true,
      "hoverinfo": "skip"
    },
    "noisy_band_lo": {
      "name": "noisy signal (~1σ envelope)",
      "mode": "lines",
      "line": { "width": 0, "color": "rgba(255,165,0,0)" },
      "showlegend": false,
      "hoverinfo": "skip"
    },
    "noisy_band_hi": {
      "name": "noisy signal (~1σ envelope)",
      "mode": "lines",
      "line": { "width": 0, "color": "rgba(255,165,0,0)" },
      "fill": "tonexty",
      "fillcolor": "rgba(255,165,0,0.30)",
      "showlegend": true,
      "hoverinfo": "skip"
    },
    "noisy_signal": {
      "name": "simulated noisy signal (over-frequency)",
      "mode": "lines",
      "line": { "color": "orange", "dash": "dot" }
    },
    "meas_dist_baseline": {
      "mode": "lines",
      "line": { "width": 0, "color": "rgba(111,66,193,0)" },
      "showlegend": false,
      "hoverinfo": "skip"
    },
    "meas_dist": {
      "name": "measurement distribution",
      "mode": "lines",
      "visible": "legendonly",
      "line": { "color": "rgba(111,66,193,0.95)", "width": 1.5 },
      "fill": "tonexty",
      "fillcolor": "rgba(111,66,193,0.30)",
      "hovertemplate": "x=%{x}<br>relative density=%{customdata:.1f}%<extra></extra>"
    },
    "coarse": {
      "name": "measurements (coarse)",
      "mode": "markers",
      "marker": {
        "size": 7,
        "color": "rgba(176,176,176,0.95)",
        "line": { "width": 0.6, "color": "#4a4a4a" }
      },
      "hovertemplate": "x=%{x}<br>y=%{y:.4f}<br>down=%{customdata:.1f}%<extra></extra>"
    },
    "secondary": {
      "name": "measurements (secondary)",
      "mode": "markers",
      "marker": {
        "size": 7,
        "color": "rgba(255,127,14,0.9)",
        "line": { "width": 0.6, "color": "#8B4513" }
      },
      "hovertemplate": "x=%{x}<br>y=%{y:.4f}<br>down=%{customdata:.1f}%<extra></extra>"
    },
    "tertiary": {
      "name": "measurements (tertiary)",
      "mode": "markers",
      "marker": {
        "size": 7,
        "color": "rgba(148,0,211,0.9)",
        "line": { "width": 0.6, "color": "#4B0082" }
      },
      "hovertemplate": "x=%{x}<br>y=%{y:.4f}<br>down=%{customdata:.1f}%<extra></extra>"
    },
    "inference": {
      "name": "measurements (inference)",
      "mode": "markers",
      "marker": {
        "size": 8,
        "colorscale": "Viridis",
        "showscale": true,
        "line": { "width": 0.5, "color": "black" }
      },
      "hovertemplate": "x=%{x}<br>y=%{y:.4f}<br>down=%{customdata:.1f}%<extra></extra>"
    },
    "steps_noisy": {
      "name": "measurements (noisy)",
      "mode": "markers",
      "marker": {
        "size": 8,
        "colorscale": "Viridis",
        "showscale": true,
        "line": { "width": 0.5, "color": "black" }
      },
      "hovertemplate": "x=%{x}<br>y=%{y:.4f}<br>down=%{customdata:.1f}%<br>step=%{marker.color}<extra></extra>"
    },
    "mode_signal": {
      "name": "locator most likely signal",
      "mode": "lines",
      "line": { "color": "#d62728", "width": 2, "dash": "dash" }
    },
    "sobol_meas": {
      "name": "sobol measurements (noisy)",
      "mode": "markers",
      "visible": "legendonly",
      "marker": {
        "size": 6,
        "color": "rgba(100, 116, 139, 0.4)",
        "line": { "width": 0.8, "color": "rgba(30, 41, 59, 0.7)" }
      },
      "hovertemplate": "sobol x=%{x}<br>y=%{y:.4f}<br>down=%{customdata:.1f}%<extra></extra>"
    },
    "sobol_mode": {
      "name": "sobol most likely signal",
      "mode": "lines",
      "visible": "legendonly",
      "line": { "color": "#805ad5", "width": 2, "dash": "dashdot" }
    },
    "sweep_meas": {
      "name": "simple sweep measurements (noisy)",
      "mode": "markers",
      "visible": "legendonly",
      "marker": {
        "size": 6,
        "color": "rgba(234, 88, 12, 0.4)",
        "line": { "width": 0.8, "color": "rgba(154, 52, 18, 0.7)" }
      },
      "hovertemplate": "sweep x=%{x}<br>y=%{y:.4f}<br>down=%{customdata:.1f}%<extra></extra>"
    },
    "sweep_mode": {
      "name": "simple sweep most likely signal",
      "mode": "lines",
      "visible": "legendonly",
      "line": { "color": "#ea580c", "width": 2, "dash": "dashdot" }
    },
    "entropy": {
      "name": "Entropy",
      "mode": "lines+markers",
      "line": { "color": "red" }
    },
    "uncertainty": {
      "name": "Uncertainty",
      "mode": "lines+markers",
      "line": { "color": "green" }
    }
  },
  "layout": {
    "no_metrics": {
      "title": { "text": "Scan with sampled measurements" },
      "paper_bgcolor": "white",
      "plot_bgcolor": "#E5ECF6",
      "hovermode": "closest",
      "margin": { "t": 110 },
      "xaxis": {
        "title": { "text": "frequency" },
        "tickformat": "~s",
        "gridcolor": "white",
        "linecolor": "white",
        "zerolinecolor": "white"
      },
      "yaxis": {
        "title": { "text": "intensity (photon count)" },
        "gridcolor": "white",
        "linecolor": "white",
        "zerolinecolor": "white"
      },
      "legend": {
        "orientation": "h",
        "yanchor": "bottom",
        "y": 1.02,
        "xanchor": "left",
        "x": 0.0
      }
    },
    "with_metrics": {
      "title": { "text": "Scan with sampled measurements" },
      "paper_bgcolor": "white",
      "plot_bgcolor": "#E5ECF6",
      "hovermode": "closest",
      "height": 800,
      "xaxis": {
        "title": { "text": "frequency" },
        "tickformat": "~s",
        "domain": [0.0, 1.0],
        "anchor": "y",
        "gridcolor": "white",
        "linecolor": "white",
        "zerolinecolor": "white"
      },
      "yaxis": {
        "title": { "text": "intensity" },
        "domain": [0.405, 1.0],
        "anchor": "x",
        "gridcolor": "white",
        "linecolor": "white",
        "zerolinecolor": "white"
      },
      "xaxis2": {
        "title": { "text": "step" },
        "domain": [0.0, 1.0],
        "anchor": "y2",
        "gridcolor": "white",
        "linecolor": "white",
        "zerolinecolor": "white"
      },
      "yaxis2": {
        "title": { "text": "metric value" },
        "domain": [0.0, 0.255],
        "anchor": "x2",
        "gridcolor": "white",
        "linecolor": "white",
        "zerolinecolor": "white"
      },
      "yaxis3": {
        "title": { "text": "uncertainty" },
        "overlaying": "y2",
        "side": "right",
        "anchor": "x2"
      },
      "legend": {
        "orientation": "h",
        "yanchor": "bottom",
        "y": 1.02,
        "xanchor": "right",
        "x": 1
      },
      "annotations": [
        {
          "text": "Scan Measurements",
          "x": 0.5,
          "y": 1.0,
          "xref": "paper",
          "yref": "paper",
          "xanchor": "center",
          "yanchor": "bottom",
          "showarrow": false,
          "font": { "size": 16 }
        },
        {
          "text": "Convergence Metrics",
          "x": 0.5,
          "y": 0.255,
          "xref": "paper",
          "yref": "paper",
          "xanchor": "center",
          "yanchor": "bottom",
          "showarrow": false,
          "font": { "size": 16 }
        }
      ]
    }
  },
  "focus_window_style": {
    "fillcolor": "rgba(46, 204, 113, 0.16)",
    "line_color": "rgba(46, 204, 113, 0.7)",
    "annotation": "Bayesian focus area"
  },
  "per_dip_colors": [
    { "fill": "rgba(255, 159, 64, 0.20)", "line": "rgba(255, 159, 64, 0.8)" },
    { "fill": "rgba(153, 102, 255, 0.20)", "line": "rgba(153, 102, 255, 0.8)" },
    { "fill": "rgba(54, 162, 235, 0.20)", "line": "rgba(54, 162, 235, 0.8)" }
  ],
  "center_freq_style": {
    "line_color": "#334155",
    "annotation": "true frequency"
  }
}
