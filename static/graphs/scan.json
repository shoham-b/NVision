{
  "version": 1,
  "traces": {
    "true_signal": {
      "type": "scatter",
      "mode": "lines",
      "name": "true signal",
      "line": { "color": "blue" }
    },
    "noisy_signal": {
      "type": "scatter",
      "mode": "lines",
      "name": "simulated noisy signal (over-frequency)",
      "line": { "color": "orange", "dash": "dot" }
    },
    "noisy_band_lo": {
      "type": "scatter",
      "mode": "lines",
      "line": { "width": 0, "color": "rgba(255,165,0,0)" },
      "showlegend": false,
      "hoverinfo": "skip"
    },
    "noisy_band_hi": {
      "type": "scatter",
      "mode": "lines",
      "name": "possible measurement range (±1σ)",
      "line": { "width": 0, "color": "rgba(255,165,0,0)" },
      "fill": "tonexty",
      "fillcolor": "rgba(255,165,0,0.28)",
      "hoverinfo": "skip"
    },
    "noisy_band_lo2": {
      "type": "scatter",
      "mode": "lines",
      "line": { "width": 0, "color": "rgba(255,165,0,0)" },
      "showlegend": false,
      "hoverinfo": "skip"
    },
    "noisy_band_hi2": {
      "type": "scatter",
      "mode": "lines",
      "name": "possible measurement range (±2σ)",
      "line": { "width": 0, "color": "rgba(255,165,0,0)" },
      "fill": "tonexty",
      "fillcolor": "rgba(255,165,0,0.12)",
      "hoverinfo": "skip"
    },
    "meas_dist_baseline": {
      "type": "scatter",
      "mode": "lines",
      "line": { "width": 0, "color": "rgba(111,66,193,0)" },
      "showlegend": false,
      "hoverinfo": "skip"
    },
    "meas_dist": {
      "type": "scatter",
      "mode": "lines",
      "name": "measurement distribution",
      "visible": "legendonly",
      "line": { "color": "rgba(111,66,193,0.95)", "width": 1.5 },
      "fill": "tonexty",
      "fillcolor": "rgba(111,66,193,0.30)",
      "hovertemplate": "x=%{x}<br>relative density=%{customdata:.1f}%<extra></extra>"
    },
    "coarse": {
      "type": "scatter",
      "mode": "markers",
      "name": "measurements (coarse)",
      "marker": {
        "size": 7,
        "color": "rgba(176,176,176,0.95)",
        "line": { "width": 0.6, "color": "#4a4a4a" }
      },
      "hovertemplate": "x=%{x}<br>y=%{y:.4f}<br>down=%{customdata:.1f}%<extra></extra>"
    },
    "secondary": {
      "type": "scatter",
      "mode": "markers",
      "name": "measurements (secondary)",
      "marker": {
        "size": 7,
        "color": "rgba(255,127,14,0.9)",
        "line": { "width": 0.6, "color": "#8B4513" }
      },
      "hovertemplate": "x=%{x}<br>y=%{y:.4f}<br>down=%{customdata:.1f}%<extra></extra>"
    },
    "tertiary": {
      "type": "scatter",
      "mode": "markers",
      "name": "measurements (tertiary)",
      "marker": {
        "size": 7,
        "color": "rgba(148,0,211,0.9)",
        "line": { "width": 0.6, "color": "#4B0082" }
      },
      "hovertemplate": "x=%{x}<br>y=%{y:.4f}<br>down=%{customdata:.1f}%<extra></extra>"
    },
    "inference": {
      "type": "scatter",
      "mode": "markers",
      "name": "measurements (inference)",
      "marker": {
        "size": 8,
        "colorscale": "Viridis",
        "showscale": true,
        "line": { "width": 0.5, "color": "black" }
      },
      "hovertemplate": "x=%{x}<br>y=%{y:.4f}<br>down=%{customdata:.1f}%<extra></extra>"
    },
    "steps_noisy": {
      "type": "scatter",
      "mode": "markers",
      "name": "measurements (noisy)",
      "marker": {
        "size": 8,
        "colorscale": "Viridis",
        "showscale": true,
        "line": { "width": 0.5, "color": "black" }
      },
      "hovertemplate": "x=%{x}<br>y=%{y:.4f}<br>down=%{customdata:.1f}%<br>step=%{marker.color}<extra></extra>"
    },
    "mode_signal": {
      "type": "scatter",
      "mode": "lines",
      "name": "locator most likely signal",
      "line": { "color": "#d62728", "width": 2, "dash": "dash" }
    },
    "sobol_meas": {
      "type": "scatter",
      "mode": "markers",
      "name": "sobol measurements (noisy)",
      "marker": {
        "size": 7,
        "color": "rgba(23,190,207,0.85)",
        "line": { "width": 0.6, "color": "#0b5c66" }
      },
      "hovertemplate": "x=%{x}<br>y=%{y:.4f}<br>down=%{customdata:.1f}%<extra></extra>"
    },
    "sobol_mode": {
      "type": "scatter",
      "mode": "lines",
      "name": "sobol most likely signal",
      "line": { "color": "#17becf", "width": 2, "dash": "dash" }
    },
    "sweep_meas": {
      "type": "scatter",
      "mode": "markers",
      "name": "sweep measurements (noisy)",
      "marker": {
        "size": 7,
        "color": "rgba(140,140,60,0.85)",
        "line": { "width": 0.6, "color": "#5c5c1e" }
      },
      "hovertemplate": "x=%{x}<br>y=%{y:.4f}<br>down=%{customdata:.1f}%<extra></extra>"
    },
    "sweep_mode": {
      "type": "scatter",
      "mode": "lines",
      "name": "sweep most likely signal",
      "line": { "color": "#bcbd22", "width": 2, "dash": "dash" }
    },
    "entropy": {
      "type": "scatter",
      "mode": "lines+markers",
      "name": "Entropy",
      "line": { "color": "red" }
    },
    "uncertainty": {
      "type": "scatter",
      "mode": "lines+markers",
      "name": "Uncertainty",
      "line": { "color": "green" }
    }
  },
  "layout": {
    "no_metrics": {
      "xaxis": { "title": { "text": "frequency" } },
      "yaxis": { "title": { "text": "signal" } },
      "legend": { "orientation": "h" },
      "hovermode": "closest",
      "margin": { "t": 60 }
    },
    "with_metrics": {
      "xaxis": { "title": { "text": "frequency" }, "domain": [0, 1], "anchor": "y" },
      "yaxis": { "title": { "text": "signal" }, "domain": [0.4, 1] },
      "xaxis2": { "title": { "text": "step" }, "domain": [0, 1], "anchor": "y2" },
      "yaxis2": { "title": { "text": "Entropy" }, "domain": [0, 0.28] },
      "yaxis3": { "title": { "text": "Uncertainty" }, "overlaying": "y2", "side": "right" },
      "legend": { "orientation": "h" },
      "hovermode": "closest",
      "margin": { "t": 60 }
    }
  },
  "focus_window_style": {
    "fillcolor": "rgba(46, 204, 113, 0.16)",
    "line_color": "rgba(46, 204, 113, 0.7)",
    "annotation": "Bayesian focus area"
  },
  "per_dip_colors": [
    { "fill": "rgba(255, 159, 64, 0.20)", "line": "rgba(255, 159, 64, 0.8)" },
    { "fill": "rgba(153, 102, 255, 0.20)", "line": "rgba(153, 102, 255, 0.8)" },
    { "fill": "rgba(54, 162, 235, 0.20)", "line": "rgba(54, 162, 235, 0.8)" }
  ],
  "center_freq_style": {
    "line_color": "#2c3e50",
    "annotation": "true frequency"
  }
}
