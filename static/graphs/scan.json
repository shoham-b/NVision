{
  "version": 1,
  "traces": {
    "true_signal": {
      "type": "scatter",
      "mode": "lines",
      "name": "True Signal",
      "line": { "color": "#0056b3", "width": 2 },
      "hovertemplate": "%{y}<extra>True Signal</extra>"
    },
    "noisy_signal": {
      "type": "scatter",
      "mode": "lines",
      "name": "Simulated Signal (single draw)",
      "line": { "color": "#64748b", "width": 1, "dash": "dot" },
      "hovertemplate": "%{y}<extra>Simulated Signal</extra>"
    },
    "noisy_band_lo2": {
      "type": "scatter",
      "mode": "lines",
      "name": "-2σ",
      "line": { "width": 0 },
      "showlegend": false,
      "hoverinfo": "skip"
    },
    "noisy_band_hi2": {
      "type": "scatter",
      "mode": "lines",
      "name": "±2σ range",
      "line": { "width": 0 },
      "fill": "tonexty",
      "fillcolor": "rgba(0, 86, 179, 0.08)",
      "hoverinfo": "skip"
    },
    "noisy_band_lo": {
      "type": "scatter",
      "mode": "lines",
      "name": "-1σ",
      "line": { "width": 0 },
      "showlegend": false,
      "hoverinfo": "skip"
    },
    "noisy_band_hi": {
      "type": "scatter",
      "mode": "lines",
      "name": "±1σ range",
      "line": { "width": 0 },
      "fill": "tonexty",
      "fillcolor": "rgba(0, 86, 179, 0.18)",
      "hoverinfo": "skip"
    },
    "meas_dist_baseline": {
      "type": "scatter",
      "mode": "lines",
      "name": "baseline",
      "line": { "width": 0 },
      "showlegend": false,
      "hoverinfo": "skip"
    },
    "meas_dist": {
      "type": "scatter",
      "mode": "lines",
      "name": "Measurement density",
      "line": { "color": "#94a3b8", "width": 1 },
      "fill": "tonexty",
      "fillcolor": "rgba(148, 163, 184, 0.25)",
      "hovertemplate": "%{customdata}<extra>Measurement density</extra>"
    },
    "coarse": {
      "type": "scatter",
      "mode": "markers",
      "name": "Coarse",
      "marker": { "color": "#c2410c", "size": 8, "symbol": "diamond" },
      "hovertemplate": "%{y}<br>Depth: %{customdata:.1f}%<extra>Coarse</extra>"
    },
    "secondary": {
      "type": "scatter",
      "mode": "markers",
      "name": "Secondary",
      "marker": { "color": "#b45309", "size": 7, "symbol": "square" },
      "hovertemplate": "%{y}<br>Depth: %{customdata:.1f}%<extra>Secondary</extra>"
    },
    "tertiary": {
      "type": "scatter",
      "mode": "markers",
      "name": "Tertiary",
      "marker": { "color": "#a16207", "size": 6, "symbol": "triangle-up" },
      "hovertemplate": "%{y}<br>Depth: %{customdata:.1f}%<extra>Tertiary</extra>"
    },
    "inference": {
      "type": "scatter",
      "mode": "markers",
      "name": "Inference",
      "marker": {
        "size": 6,
        "symbol": "circle",
        "colorscale": "Viridis",
        "line": { "width": 0.5, "color": "#1e293b" }
      },
      "hovertemplate": "%{y}<br>Depth: %{customdata:.1f}%<extra>Inference</extra>"
    },
    "steps_noisy": {
      "type": "scatter",
      "mode": "markers",
      "name": "Measurements",
      "marker": {
        "size": 6,
        "symbol": "circle",
        "colorscale": "Viridis",
        "line": { "width": 0.5, "color": "#1e293b" }
      },
      "hovertemplate": "%{y}<br>Depth: %{customdata:.1f}%<extra>Measurements</extra>"
    },
    "mode_signal": {
      "type": "scatter",
      "mode": "lines",
      "name": "Mode estimate",
      "line": { "color": "#15803d", "width": 2, "dash": "dash" },
      "hovertemplate": "%{y}<extra>Mode estimate</extra>"
    },
    "sobol_meas": {
      "type": "scatter",
      "mode": "markers",
      "name": "Sobol measurements",
      "marker": { "color": "#7c3aed", "size": 6, "symbol": "x" },
      "hovertemplate": "%{y}<br>Depth: %{customdata:.1f}%<extra>Sobol measurements</extra>"
    },
    "sobol_mode": {
      "type": "scatter",
      "mode": "lines",
      "name": "Sobol mode",
      "line": { "color": "#7c3aed", "width": 2, "dash": "dot" },
      "hovertemplate": "%{y}<extra>Sobol mode</extra>"
    },
    "sweep_meas": {
      "type": "scatter",
      "mode": "markers",
      "name": "Sweep measurements",
      "marker": { "color": "#db2777", "size": 6, "symbol": "cross" },
      "hovertemplate": "%{y}<br>Depth: %{customdata:.1f}%<extra>Sweep measurements</extra>"
    },
    "sweep_mode": {
      "type": "scatter",
      "mode": "lines",
      "name": "Sweep mode",
      "line": { "color": "#db2777", "width": 2, "dash": "dot" },
      "hovertemplate": "%{y}<extra>Sweep mode</extra>"
    },
    "entropy": {
      "type": "scatter",
      "mode": "lines",
      "name": "Entropy",
      "line": { "color": "#0891b2", "width": 2 },
      "hovertemplate": "%{y}<extra>Entropy</extra>"
    },
    "uncertainty": {
      "type": "scatter",
      "mode": "lines",
      "name": "Uncertainty",
      "line": { "color": "#b91c1c", "width": 2 },
      "hovertemplate": "%{y}<extra>Uncertainty</extra>"
    }
  },
  "layout": {
    "no_metrics": {
      "template": "plotly_white",
      "hovermode": "closest",
      "margin": { "t": 30, "r": 30, "b": 50, "l": 60 },
      "legend": { "orientation": "h", "y": -0.15 },
      "xaxis": { "title": { "text": "Frequency" } },
      "yaxis": { "title": { "text": "Signal" } }
    },
    "with_metrics": {
      "template": "plotly_white",
      "hovermode": "closest",
      "margin": { "t": 30, "r": 60, "b": 50, "l": 60 },
      "legend": { "orientation": "h", "y": -0.08 },
      "xaxis": { "title": { "text": "Frequency" }, "domain": [0, 1], "anchor": "y" },
      "yaxis": { "title": { "text": "Signal" }, "domain": [0.4, 1] },
      "xaxis2": { "title": { "text": "Step" }, "domain": [0, 1], "anchor": "y2" },
      "yaxis2": { "title": { "text": "Entropy" }, "domain": [0, 0.25], "anchor": "x2" },
      "yaxis3": {
        "title": { "text": "Uncertainty" },
        "domain": [0, 0.25],
        "anchor": "x2",
        "overlaying": "y2",
        "side": "right"
      }
    }
  },
  "focus_window_style": {
    "fillcolor": "rgba(0, 86, 179, 0.08)",
    "line_color": "#0056b3",
    "annotation": "Focus window"
  },
  "per_dip_colors": [
    { "fill": "rgba(194, 65, 12, 0.10)", "line": "#c2410c" },
    { "fill": "rgba(21, 128, 61, 0.10)", "line": "#15803d" },
    { "fill": "rgba(124, 58, 237, 0.10)", "line": "#7c3aed" },
    { "fill": "rgba(219, 39, 119, 0.10)", "line": "#db2777" }
  ],
  "center_freq_style": {
    "line_color": "#b91c1c",
    "annotation": "True frequency"
  }
}
