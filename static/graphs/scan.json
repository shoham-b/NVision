{
  "version": 1,
  "traces": {
    "true_signal": {
      "mode": "lines",
      "name": "true signal",
      "line": {
        "color": "blue"
      }
    },
    "noisy_signal": {
      "mode": "lines",
      "name": "simulated noisy signal (over-frequency)",
      "line": {
        "color": "orange",
        "dash": "dot"
      }
    },
    "noisy_band_lo2": {
      "mode": "lines",
      "name": "noisy envelope (\u00b12\u03c3)",
      "line": {
        "width": 0,
        "color": "rgba(255,165,0,0)"
      },
      "showlegend": false,
      "hoverinfo": "skip"
    },
    "noisy_band_hi2": {
      "mode": "lines",
      "name": "noisy envelope (\u00b12\u03c3)",
      "line": {
        "width": 0,
        "color": "rgba(255,165,0,0)"
      },
      "fill": "tonexty",
      "fillcolor": "rgba(255,165,0,0.12)",
      "hoverinfo": "skip"
    },
    "noisy_band_lo": {
      "mode": "lines",
      "name": "noisy envelope (\u00b11\u03c3)",
      "line": {
        "width": 0,
        "color": "rgba(255,165,0,0)"
      },
      "showlegend": false,
      "hoverinfo": "skip"
    },
    "noisy_band_hi": {
      "mode": "lines",
      "name": "noisy envelope (\u00b11\u03c3)",
      "line": {
        "width": 0,
        "color": "rgba(255,165,0,0)"
      },
      "fill": "tonexty",
      "fillcolor": "rgba(255,165,0,0.25)",
      "hoverinfo": "skip"
    },
    "meas_dist_baseline": {
      "mode": "lines",
      "line": {
        "width": 0,
        "color": "rgba(111,66,193,0)"
      },
      "showlegend": false,
      "hoverinfo": "skip"
    },
    "meas_dist": {
      "mode": "lines",
      "name": "measurement distribution",
      "visible": "legendonly",
      "line": {
        "color": "rgba(111,66,193,0.95)",
        "width": 1.5
      },
      "fill": "tonexty",
      "fillcolor": "rgba(111,66,193,0.30)",
      "hovertemplate": "x=%{x}<br>relative density=%{customdata:.1f}%<extra></extra>"
    },
    "coarse": {
      "mode": "markers",
      "name": "measurements (coarse)",
      "marker": {
        "size": 7,
        "color": "rgba(176,176,176,0.95)",
        "line": {
          "width": 0.6,
          "color": "#4a4a4a"
        }
      },
      "hovertemplate": "x=%{x}<br>y=%{y:.4f}<br>down=%{customdata:.1f}%<extra></extra>"
    },
    "secondary": {
      "mode": "markers",
      "name": "measurements (secondary)",
      "marker": {
        "size": 7,
        "color": "rgba(255,127,14,0.9)",
        "line": {
          "width": 0.6,
          "color": "#8B4513"
        }
      },
      "hovertemplate": "x=%{x}<br>y=%{y:.4f}<br>down=%{customdata:.1f}%<extra></extra>"
    },
    "tertiary": {
      "mode": "markers",
      "name": "measurements (tertiary)",
      "marker": {
        "size": 7,
        "color": "rgba(148,0,211,0.9)",
        "line": {
          "width": 0.6,
          "color": "#4B0082"
        }
      },
      "hovertemplate": "x=%{x}<br>y=%{y:.4f}<br>down=%{customdata:.1f}%<extra></extra>"
    },
    "inference": {
      "mode": "markers",
      "name": "measurements (inference)",
      "marker": {
        "size": 8,
        "colorscale": "Viridis",
        "showscale": true,
        "line": {
          "width": 0.5,
          "color": "black"
        }
      },
      "hovertemplate": "x=%{x}<br>y=%{y:.4f}<br>down=%{customdata:.1f}%<extra></extra>"
    },
    "steps_noisy": {
      "mode": "markers",
      "name": "measurements (noisy)",
      "marker": {
        "size": 8,
        "colorscale": "Viridis",
        "showscale": true,
        "line": {
          "width": 0.5,
          "color": "black"
        }
      },
      "hovertemplate": "x=%{x}<br>y=%{y:.4f}<br>down=%{customdata:.1f}%<br>step=%{marker.color}<extra></extra>"
    },
    "mode_signal": {
      "mode": "lines",
      "name": "locator most likely signal",
      "line": {
        "color": "#d62728",
        "width": 2,
        "dash": "dash"
      }
    },
    "sobol_meas": {
      "mode": "markers",
      "visible": "legendonly",
      "name": "sobol measurements (noisy)",
      "marker": {
        "size": 6,
        "color": "rgba(100, 116, 139, 0.4)",
        "line": {
          "width": 0.8,
          "color": "rgba(30, 41, 59, 0.7)"
        }
      },
      "hovertemplate": "sobol x=%{x}<br>y=%{y:.4f}<br>down=%{customdata:.1f}%<extra></extra>"
    },
    "sobol_mode": {
      "mode": "lines",
      "visible": "legendonly",
      "name": "sobol most likely signal",
      "line": {
        "color": "#805ad5",
        "width": 2,
        "dash": "dashdot"
      }
    },
    "sweep_meas": {
      "mode": "markers",
      "visible": "legendonly",
      "name": "simple sweep measurements (noisy)",
      "marker": {
        "size": 6,
        "color": "rgba(234, 88, 12, 0.4)",
        "line": {
          "width": 0.8,
          "color": "rgba(154, 52, 18, 0.7)"
        }
      },
      "hovertemplate": "sweep x=%{x}<br>y=%{y:.4f}<br>down=%{customdata:.1f}%<extra></extra>"
    },
    "sweep_mode": {
      "mode": "lines",
      "visible": "legendonly",
      "name": "simple sweep most likely signal",
      "line": {
        "color": "#ea580c",
        "width": 2,
        "dash": "dashdot"
      }
    },
    "entropy": {
      "mode": "lines+markers",
      "name": "Entropy",
      "line": {
        "color": "red"
      }
    },
    "uncertainty": {
      "mode": "lines+markers",
      "name": "Uncertainty",
      "line": {
        "color": "green"
      }
    }
  },
  "layout": {
