{
    "version": 1,
    "traces": {
        "true_signal": {
            "type": "scatter",
            "mode": "lines",
            "name": "True signal",
            "legendgroup": "true_signal",
            "line": { "color": "#333333", "width": 1.5 },
            "hoverinfo": "x+y"
        },
        "noisy_band_lo2": {
            "type": "scatter",
            "mode": "lines",
            "name": "Measurement range (±2σ)",
            "legendgroup": "noisy_band2",
            "line": { "color": "rgba(0,86,179,0)", "width": 0 },
            "showlegend": false,
            "hoverinfo": "skip"
        },
        "noisy_band_hi2": {
            "type": "scatter",
            "mode": "lines",
            "name": "Measurement range (±2σ)",
            "legendgroup": "noisy_band2",
            "line": { "color": "rgba(0,86,179,0)", "width": 0 },
            "fill": "tonexty",
            "fillcolor": "rgba(0,86,179,0.10)",
            "showlegend": true,
            "hoverinfo": "skip"
        },
        "noisy_band_lo": {
            "type": "scatter",
            "mode": "lines",
            "name": "Measurement range (±1σ)",
            "legendgroup": "noisy_band1",
            "line": { "color": "rgba(0,86,179,0)", "width": 0 },
            "showlegend": false,
            "hoverinfo": "skip"
        },
        "noisy_band_hi": {
            "type": "scatter",
            "mode": "lines",
            "name": "Measurement range (±1σ)",
            "legendgroup": "noisy_band1",
            "line": { "color": "rgba(0,86,179,0)", "width": 0 },
            "fill": "tonexty",
            "fillcolor": "rgba(0,86,179,0.22)",
            "showlegend": true,
            "hoverinfo": "skip"
        },
        "noisy_signal": {
            "type": "scatter",
            "mode": "lines",
            "name": "Noisy signal",
            "line": { "color": "#6db3f5", "width": 1, "dash": "dot" },
            "hoverinfo": "x+y"
        },
        "meas_dist_baseline": {
            "type": "scatter",
            "mode": "lines",
            "name": "Measurement distribution",
            "legendgroup": "meas_dist",
            "showlegend": false,
            "line": { "color": "rgba(128,0,128,0)", "width": 0 },
            "hoverinfo": "skip"
        },
        "meas_dist": {
            "type": "scatter",
            "mode": "lines",
            "name": "Measurement distribution",
            "legendgroup": "meas_dist",
            "line": { "color": "rgba(128,0,128,0)", "width": 0 },
            "fill": "tonexty",
            "fillcolor": "rgba(128,0,128,0.18)",
            "hoverinfo": "skip"
        },
        "coarse": {
            "type": "scatter",
            "mode": "markers",
            "name": "Coarse measurements",
            "marker": { "color": "#888888", "size": 6, "symbol": "circle" },
            "hovertemplate": "x=%{x}<br>y=%{y}<br>depth=%{customdata:.1f}%<extra>coarse</extra>"
        },
        "secondary": {
            "type": "scatter",
            "mode": "markers",
            "name": "Secondary measurements",
            "marker": { "color": "#0056b3", "size": 6, "symbol": "diamond" },
            "hovertemplate": "x=%{x}<br>y=%{y}<br>depth=%{customdata:.1f}%<extra>secondary</extra>"
        },
        "tertiary": {
            "type": "scatter",
            "mode": "markers",
            "name": "Tertiary measurements",
            "marker": { "color": "#003d82", "size": 6, "symbol": "square" },
            "hovertemplate": "x=%{x}<br>y=%{y}<br>depth=%{customdata:.1f}%<extra>tertiary</extra>"
        },
        "inference": {
            "type": "scatter",
            "mode": "markers",
            "name": "Fine (inference) measurements",
            "marker": {
                "size": 7,
                "symbol": "circle",
                "colorscale": "Viridis",
                "showscale": true
            },
            "hovertemplate": "x=%{x}<br>y=%{y}<br>depth=%{customdata:.1f}%<extra>inference</extra>"
        },
        "steps_noisy": {
            "type": "scatter",
            "mode": "markers",
            "name": "Measurements",
            "marker": {
                "size": 7,
                "symbol": "circle",
                "colorscale": "Viridis",
                "showscale": true
            },
            "hovertemplate": "x=%{x}<br>y=%{y}<br>depth=%{customdata:.1f}%<extra>measurement</extra>"
        },
        "mode_signal": {
            "type": "scatter",
            "mode": "lines",
            "name": "Estimated signal",
            "line": { "color": "#2e7d32", "width": 1.5, "dash": "dash" },
            "hoverinfo": "x+y"
        },
        "sobol_meas": {
            "type": "scatter",
            "mode": "markers",
            "name": "Sobol measurements",
            "marker": { "color": "#e07b00", "size": 6, "symbol": "triangle-up" },
            "hovertemplate": "x=%{x}<br>y=%{y}<br>depth=%{customdata:.1f}%<extra>sobol</extra>"
        },
        "sobol_mode": {
            "type": "scatter",
            "mode": "lines",
            "name": "Sobol estimated signal",
            "line": { "color": "#e07b00", "width": 1.5, "dash": "dot" },
            "hoverinfo": "x+y"
        },
        "sweep_meas": {
            "type": "scatter",
            "mode": "markers",
            "name": "Sweep measurements",
            "marker": { "color": "#c62828", "size": 6, "symbol": "triangle-down" },
            "hovertemplate": "x=%{x}<br>y=%{y}<br>depth=%{customdata:.1f}%<extra>sweep</extra>"
        },
        "sweep_mode": {
            "type": "scatter",
            "mode": "lines",
            "name": "Sweep estimated signal",
            "line": { "color": "#c62828", "width": 1.5, "dash": "dot" },
            "hoverinfo": "x+y"
        },
        "entropy": {
            "type": "scatter",
            "mode": "lines+markers",
            "name": "Entropy",
            "line": { "color": "#6a1b9a", "width": 1.5 },
            "marker": { "size": 4 },
            "hoverinfo": "x+y"
        },
        "uncertainty": {
            "type": "scatter",
            "mode": "lines+markers",
            "name": "Uncertainty",
            "line": { "color": "#00838f", "width": 1.5 },
            "marker": { "size": 4 },
            "hoverinfo": "x+y"
        }
    },
    "layout": {
        "no_metrics": {
            "xaxis": { "title": { "text": "Frequency (Hz)" }, "domain": [0, 1], "anchor": "y" },
            "yaxis": { "title": { "text": "Signal" }, "domain": [0, 1], "anchor": "x" },
            "legend": { "orientation": "h", "y": -0.2 },
            "margin": { "t": 40, "r": 20, "b": 50, "l": 60 },
            "hovermode": "closest"
        },
        "with_metrics": {
            "xaxis": { "title": { "text": "Frequency (Hz)" }, "domain": [0, 1], "anchor": "y" },
            "yaxis": { "title": { "text": "Signal" }, "domain": [0.52, 1], "anchor": "x" },
            "xaxis2": { "title": { "text": "Inference step" }, "domain": [0, 1], "anchor": "y2" },
            "yaxis2": { "title": { "text": "Entropy" }, "domain": [0.28, 0.46], "anchor": "x2" },
            "yaxis3": { "title": { "text": "Uncertainty" }, "domain": [0, 0.18], "anchor": "x2" },
            "grid": { "rows": 3, "columns": 1, "pattern": "independent" },
            "legend": { "orientation": "h", "y": -0.12 },
            "margin": { "t": 40, "r": 20, "b": 50, "l": 60 },
            "hovermode": "closest"
        }
    },
    "focus_window_style": {
        "fillcolor": "rgba(255, 193, 7, 0.15)",
        "line_color": "#ffc107",
        "annotation": "focus window"
    },
    "center_freq_style": {
        "line_color": "#c62828",
        "annotation": "true frequency"
    },
    "per_dip_colors": [
        { "fill": "rgba(0, 86, 179, 0.10)", "line": "#0056b3" },
        { "fill": "rgba(46, 125, 50, 0.10)", "line": "#2e7d32" },
        { "fill": "rgba(224, 123, 0, 0.10)", "line": "#e07b00" },
        { "fill": "rgba(106, 27, 154, 0.10)", "line": "#6a1b9a" },
        { "fill": "rgba(0, 131, 143, 0.10)", "line": "#00838f" },
        { "fill": "rgba(198, 40, 40, 0.10)", "line": "#c62828" }
    ]
}
