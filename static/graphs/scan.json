{
  "version": 1,
  "traces": {
    "true_signal": {
      "type": "scatter", "mode": "lines", "name": "True signal",
      "line": { "color": "#2c3e50", "width": 2 }
    },
    "noisy_band_lo2": {
      "type": "scatter", "mode": "lines", "name": "±2σ range",
      "line": { "width": 0 }, "showlegend": false, "hoverinfo": "skip"
    },
    "noisy_band_hi2": {
      "type": "scatter", "mode": "lines", "name": "±2σ range",
      "line": { "width": 0 }, "fill": "tonexty", "fillcolor": "rgba(52, 152, 219, 0.10)",
      "hoverinfo": "skip"
    },
    "noisy_band_lo": {
      "type": "scatter", "mode": "lines", "name": "±1σ range",
      "line": { "width": 0 }, "showlegend": false, "hoverinfo": "skip"
    },
    "noisy_band_hi": {
      "type": "scatter", "mode": "lines", "name": "±1σ range",
      "line": { "width": 0 }, "fill": "tonexty", "fillcolor": "rgba(52, 152, 219, 0.25)",
      "hoverinfo": "skip"
    },
    "noisy_signal": {
      "type": "scatter", "mode": "markers", "name": "Noisy signal",
      "marker": { "size": 4, "color": "rgba(149, 165, 166, 0.6)" }
    },
    "meas_dist_baseline": {
      "type": "scatter", "mode": "lines", "name": "baseline",
      "line": { "color": "#95a5a6", "width": 1, "dash": "dot" },
      "showlegend": false, "hoverinfo": "skip"
    },
    "meas_dist": {
      "type": "scatter", "mode": "lines", "name": "Measurement density",
      "line": { "color": "#7f8c8d", "width": 1 },
      "fill": "tonexty", "fillcolor": "rgba(127, 140, 141, 0.15)"
    },
    "coarse": {
      "type": "scatter", "mode": "markers", "name": "Coarse sweep",
      "marker": { "symbol": "circle", "size": 6, "color": "#e67e22" }
    },
    "secondary": {
      "type": "scatter", "mode": "markers", "name": "Secondary sweep",
      "marker": { "symbol": "diamond", "size": 6, "color": "#9b59b6" }
    },
    "tertiary": {
      "type": "scatter", "mode": "markers", "name": "Tertiary sweep",
      "marker": { "symbol": "square", "size": 6, "color": "#16a085" }
    },
    "inference": {
      "type": "scatter", "mode": "markers", "name": "Inference measurements",
      "marker": { "size": 7, "colorscale": "Viridis", "showscale": true }
    },
    "steps_noisy": {
      "type": "scatter", "mode": "markers", "name": "Measurements",
      "marker": { "size": 6, "colorscale": "Viridis", "showscale": true }
    },
    "mode_signal": {
      "type": "scatter", "mode": "lines", "name": "MAP estimate",
      "line": { "color": "#c0392b", "width": 2, "dash": "dot" }
    },
    "sobol_meas": {
      "type": "scatter", "mode": "markers", "name": "Sobol samples",
      "marker": { "symbol": "x", "size": 6, "color": "#8e44ad" }
    },
    "sobol_mode": {
      "type": "scatter", "mode": "lines", "name": "Sobol mode",
      "line": { "color": "#8e44ad", "width": 2, "dash": "dashdot" }
    },
    "sweep_meas": {
      "type": "scatter", "mode": "markers", "name": "Sweep samples",
      "marker": { "symbol": "triangle-up", "size": 6, "color": "#2980b9" }
    },
    "sweep_mode": {
      "type": "scatter", "mode": "lines", "name": "Sweep mode",
      "line": { "color": "#2980b9", "width": 2, "dash": "dashdot" }
    },
    "entropy": {
      "type": "scatter", "mode": "lines+markers", "name": "Entropy",
      "line": { "color": "#2980b9" }, "marker": { "size": 4 }
    },
    "uncertainty": {
      "type": "scatter", "mode": "lines+markers", "name": "Uncertainty",
      "line": { "color": "#c0392b" }, "marker": { "size": 4 }
    }
  },
  "layout": {
    "with_metrics": {
      "xaxis": { "domain": [0, 1], "anchor": "y", "title": { "text": "Frequency" } },
      "yaxis": { "domain": [0.45, 1], "anchor": "x", "title": { "text": "Signal" } },
      "xaxis2": { "domain": [0, 1], "anchor": "y2", "title": { "text": "Step" } },
      "yaxis2": { "domain": [0, 0.35], "anchor": "x2", "title": { "text": "Entropy" } },
      "yaxis3": {
        "domain": [0, 0.35], "anchor": "x2", "overlaying": "y2", "side": "right",
        "title": { "text": "Uncertainty" }
      },
      "legend": { "orientation": "h", "y": 1.08 },
      "margin": { "t": 40, "r": 60, "b": 40, "l": 60 }
    },
    "no_metrics": {
      "xaxis": { "title": { "text": "Frequency" } },
      "yaxis": { "title": { "text": "Signal" } },
      "legend": { "orientation": "h", "y": 1.08 },
      "margin": { "t": 40, "r": 20, "b": 40, "l": 60 }
    }
  },
  "focus_window_style": {
    "fillcolor": "rgba(241, 196, 15, 0.15)",
    "line_color": "#f39c12",
    "annotation": "Focus window"
  },
  "per_dip_colors": [
    { "fill": "rgba(231, 76, 60, 0.12)", "line": "#e74c3c" },
    { "fill": "rgba(52, 152, 219, 0.12)", "line": "#3498db" },
    { "fill": "rgba(46, 204, 113, 0.12)", "line": "#2ecc71" },
    { "fill": "rgba(155, 89, 182, 0.12)", "line": "#9b59b6" }
  ],
  "center_freq_style": {
    "line_color": "#34495e",
    "annotation": "True frequency"
  }
}
