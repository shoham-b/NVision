# --- MySQL cache backend -----------------------------------------------------
#
# By default the cache is local SQLite files under <out>/cache. Set
# NVISION_CACHE_BACKEND=mysql to use a shared MySQL DB (e.g. Cloud SQL)
# instead -- needed for sharded/cloud runs where multiple worker pods must
# see (and resume from) the same cache. See nvision/cache/mysql.py.
#
# NVISION_CACHE_BACKEND=sqlite   # or "mysql"
# NVISION_MYSQL_HOST=127.0.0.1
# NVISION_MYSQL_PORT=3306
# NVISION_MYSQL_USER=nvision
# NVISION_MYSQL_PASSWORD=
# NVISION_MYSQL_DATABASE=nvision
# Set true to skip TLS entirely (e.g. a local docker-compose MySQL with no
# SSL configured); leave unset/false for anything reachable over the network.
# NVISION_MYSQL_SSL_DISABLED=False
#
# Notes:
# - `nv cache gen` (snapshot/restore) is sqlite-only -- it copies the local
#   <out>/cache directory and has no MySQL equivalent.
# - Each sharded worker pod (nv run --shard-index/--shard-count) writes to
#   its own MySQL table; `nv serve`/`nv render`/`nv cache` read across all
#   shard tables automatically (no shard flags needed for those commands).

# Minimum number of parallel runners; if a task fails with MemoryError
# the runner count is reduced until it reaches this floor, after which
# the task is allowed to fail permanently.
# NVISION_MIN_RUNNERS=2

# --- Core Locator Defaults ---------------------------------------------------
#
# Default max_steps for locators (presets.py)
#
NVISION_DEFAULT_LOC_MAX_STEPS=1500

# --- SMC Belief Parameters ---------------------------------------------------
#
# These control the Sequential Monte Carlo particle filter in
# nvision.belief.smc_marginal.
#
# NVISION_SMC_NUM_PARTICLES=1000
# NVISION_SMC_ESS_THRESHOLD=0.5
# NVISION_SMC_A_PARAM=0.98
# NVISION_SMC_MIN_EXPLORATION_FRAC=0.01
# NVISION_SMC_DIP_WINDOW_MIN_HZ=5000000.0
# NVISION_MIN_STEPS_BEFORE_NARROWING=8
# NVISION_SMC_FOCUSING_COVER_FACTOR=3.0



# --- Grid Resolution Parameters ----------------------------------------------
#
# Grid resolution for belief builders (two_peak generators)
#
# NVISION_GRID_FREQ=96
# NVISION_GRID_WIDTH=64
# NVISION_GRID_DEPTH=48
# NVISION_GRID_BACKGROUND=48

# Grid resolution for NV-center generators
#
# NVISION_NV_GRID_FREQ=500
# NVISION_NV_GRID_LINEWIDTH=80
# NVISION_NV_GRID_FWHM_TOTAL=80
# NVISION_NV_GRID_LORENTZ_FRAC=60
# NVISION_NV_GRID_SPLIT=80
# NVISION_NV_GRID_K_NP=60
# NVISION_NV_GRID_DEPTH=100
# NVISION_NV_GRID_BACKGROUND=60

# --- Sobol Sweep Parameters --------------------------------------------------
#
# Stage 1 noise baseline collection
#
# NVISION_SOBOL_MIN_POINTS=255
# NVISION_SOBOL_MAX_POINTS=511
# NVISION_SOBOL_CHECK_INTERVAL=32

# Focus window inference
#
# NVISION_SOBOL_MIN_DEPTH_SIGMA=2.5
# NVISION_SOBOL_DEPTH_FRACTION=0.5
# NVISION_SOBOL_PAD_FRACTION=0.005

# --- Sweep Steps Parameters --------------------------------------------------
#
# Coverage factor and bounds for sweep step calculation
#
# NVISION_SWEEP_COVERAGE_FACTOR=3.0
# NVISION_SWEEP_MIN_STEPS=50
# NVISION_SWEEP_MAX_STEPS=500
#
# Build graphs only for the first N repeats of each combination (later repeats keep their
# metrics and series but get no figures). 0 = every repeat.
#
# NVISION_GRAPH_REPEATS=10
#
# Number of graph-worker processes `nv run` starts. Runners save results right away and queue
# each repeat's plot inputs; a graph worker builds a combination's graphs once all its repeats
# are saved, then archives it. 0 = build graphs inline in the runners (no deferral). Unset
# defaults to half the --runners count (min 1) instead of a fixed number, so a single worker
# doesn't fall behind several runners producing finished repeats -- set this to override.
#
# NVISION_GRAPH_WORKERS=1
#
# Build the per-repeat plots for the SimpleSweep / SimpleSobol strategies (off by default:
# their data, metrics and SBED baselines are kept, only the figures are skipped).
#
# NVISION_PLOT_SWEEP_STRATEGIES=0
#
# Sweep curve-fit early stop: skip remaining starting points once a fit reaches the noise
# floor (reduced chi-square <= 1 + K*sqrt(2/dof)). K in sigmas; 0 disables (race all starts).
# Only active at high peak SNR; low-SNR fits always race every start.
#
# NVISION_SWEEP_FIT_EARLY_STOP_SIGMAS=3.0

# --- Noise Preset Parameters -------------------------------------------------
#
# Default noise levels for noise tiers
#
# NVISION_NOISE_GAUSS=0.01
# NVISION_NOISE_OVER_PROBE=0.001
#
# Varying Gaussian noise std parameters
# NVISION_NOISE_MAX_GAUSS=0.2
# NVISION_NOISE_GAUSS_STEPS=5

# --- Window/Refocus Parameters -----------------------------------------------
#
# Padding fractions for window inference
#
# NVISION_WINDOW_PADDING_FRAC=0.05
# NVISION_WINDOW_MIN_PADDING_FRAC=0.01

# --- NV Center Physical Parameter Bounds ------------------------------------
#
# Physical ranges for k_np, linewidth (HWHM), hyperfine splitting, and
# default frequency sweep window. Shared between the signal generator and
# the inference prior so they can never drift apart.
#
# NVISION_MIN_K_NP=1.0
# NVISION_MAX_K_NP=5.0
# NVISION_MIN_LINEWIDTH=200e3
# NVISION_MAX_LINEWIDTH=5.0e6
# NVISION_MIN_SPLIT=2.0e6
# NVISION_MAX_SPLIT=8.5e6

# NV center frequency domain: the upper half [D, D + delta] above the real physical
# zero-field splitting D (~2.87 GHz). The spectrum is mirror-symmetric about D, so the
# lower half would only duplicate information. Delta default (150 MHz) is
# 2.5x MAX_ZEEMAN_SPLIT (nv_center.py) -- a reasonable ~2.1 mT experiment field --
# comfortably clearing hyperfine/linewidth margins for the upper dips.
# NVISION_NV_ZERO_FIELD_SPLITTING_HZ=2.87e9
# NVISION_NV_CENTER_FREQ_DELTA_HZ=150e6

# Gaussian prior std as a fraction of parameter range (default 0.1 = 1/10 of range)
# NVISION_PRIOR_STD_FRACTION=0.1

# How far (in units of the above prior std) the generator's random draw for a
# parameter's prior *mean* is allowed to land from the true value. Default 3.0
# makes a 2-3 sigma offset the common case (simulating a real experimentalist's
# often-wrong rough calibration guess) instead of the prior mean landing
# suspiciously close to the truth almost every run. Does not change the prior's
# own reported width (still NVISION_PRIOR_STD_FRACTION) -- only where it's centered.
# NVISION_PRIOR_MEAN_OFFSET_SIGMAS=3.0

# Default relative convergence threshold (fraction of bound width; 0.01 = 1%).
# NVISION_CONVERGENCE_THRESHOLD=0.01

# Number of consecutive converged checks required before the SBED locator declares
# convergence and stops. Prevents false early-stop after the first measurement,
# especially with no/low noise where the belief can look spuriously narrow.
# NVISION_CONVERGENCE_PATIENCE=8

# Per-parameter absolute convergence ceilings (physical units). Optional.
# NVISION_FREQ_CONVERGENCE_THRESHOLD=100000.0
# NVISION_K_NP_CONVERGENCE_THRESHOLD=0.04
# NVISION_LINEWIDTH_CONVERGENCE_THRESHOLD=
# NVISION_SPLIT_CONVERGENCE_THRESHOLD=
# NVISION_DIP_DEPTH_CONVERGENCE_THRESHOLD=
# NVISION_HOMOGENEOUS_LINEWIDTH_CONVERGENCE_THRESHOLD=
# NVISION_SIGMA_INHOM_CONVERGENCE_THRESHOLD=

# --- Robust Dip Detection Parameters ------------------------------------------
#
# Sigma threshold for dip classification (default is 3.0)
# NVISION_DIP_N_SIGMA=3.0
# Minimum observations per cluster to qualify as a dip candidate (default is 2)
# NVISION_DIP_MIN_CLUSTER=2
# Max relative uncertainty in noise allowed before enabling dip focusing (default is 0.15, i.e. 15%)
# NVISION_DIP_NOISE_UNCERTAINTY_THRESHOLD=0.15
# Statistical confidence gate threshold for dip detection (default is 0.99)
# NVISION_DIP_CONFIDENCE=0.99



