# --- MySQL cache backend -----------------------------------------------------
#
# By default the cache is local SQLite files under <out>/cache. Set
# NVISION_CACHE_BACKEND=mysql to use a shared MySQL DB (e.g. Cloud SQL)
# instead -- needed for sharded/cloud runs where multiple worker pods must
# see (and resume from) the same cache. See nvision/cache/mysql.py.
#
# NVISION_CACHE_BACKEND=sqlite   # or "mysql"
# NVISION_MYSQL_HOST=127.0.0.1
# NVISION_MYSQL_PORT=3306
# NVISION_MYSQL_USER=nvision
# NVISION_MYSQL_PASSWORD=
# NVISION_MYSQL_DATABASE=nvision
# Set true to skip TLS entirely (e.g. a local docker-compose MySQL with no
# SSL configured); leave unset/false for anything reachable over the network.
# NVISION_MYSQL_SSL_DISABLED=False
#
# Notes:
# - `nv cache gen` (snapshot/restore) is sqlite-only -- it copies the local
#   <out>/cache directory and has no MySQL equivalent.
# - Each sharded worker pod (nv run --shard-index/--shard-count) writes to
#   its own MySQL table; `nv serve`/`nv render`/`nv cache` read across all
#   shard tables automatically (no shard flags needed for those commands).

# Minimum number of parallel runners; if a task fails with MemoryError
# the runner count is reduced until it reaches this floor, after which
# the task is allowed to fail permanently.
# NVISION_MIN_RUNNERS=2

# --- Core Locator Defaults ---------------------------------------------------
#
# Default max_steps for locators (presets.py)
#
NVISION_DEFAULT_LOC_MAX_STEPS=1500

# --- SMC Belief Parameters ---------------------------------------------------
#
# These control the Sequential Monte Carlo particle filter in
# nvision.belief.smc_marginal.
#
# NVISION_SMC_NUM_PARTICLES=1000
# NVISION_SMC_ESS_THRESHOLD=0.5
# NVISION_SMC_A_PARAM=0.98
# NVISION_SMC_MIN_EXPLORATION_FRAC=0.01
# NVISION_SMC_DIP_WINDOW_MIN_HZ=5000000.0
# Exploration decays as exp(-step / this): the SMC variance floor and SBED's uniform-probe share.
# NVISION_EXPLORATION_DECAY_STEPS=25.0
# NVISION_MIN_STEPS_BEFORE_NARROWING=8
# NVISION_SMC_FOCUSING_COVER_FACTOR=3.0
#
# Chunk-winner selection strategy for the EIG acquisition function
# (select_max_information_gain): "softmax" (Boltzmann sampling, temp=0.01) or
# "hardmax" (deterministic top-n by score, no RNG).
# NVISION_SMC_EIG_SELECTION_MODE=softmax



# --- Grid Resolution Parameters ----------------------------------------------
#
# Grid resolution for belief builders (two_peak generators)
#
# NVISION_GRID_FREQ=96
# NVISION_GRID_WIDTH=64
# NVISION_GRID_DEPTH=48
# NVISION_GRID_BACKGROUND=48

# Grid resolution for NV-center generators
#
# NVISION_NV_GRID_FREQ=500
# NVISION_NV_GRID_HWHM=80
# NVISION_NV_GRID_FWHM_TOTAL=80
# NVISION_NV_GRID_LORENTZ_FRAC=60
# NVISION_NV_GRID_SPLIT=80
# NVISION_NV_GRID_K_NP=60
# NVISION_NV_GRID_DEPTH=100
# NVISION_NV_GRID_BACKGROUND=60

# --- Sweep Steps Parameters --------------------------------------------------
#
# Coverage factor and bounds for sweep step calculation
#
# NVISION_SWEEP_COVERAGE_FACTOR=3.0
# NVISION_SWEEP_MIN_STEPS=50
# NVISION_SWEEP_MAX_STEPS=500
#
# Plain sweeps repeat the grid, averaging the passes, until the uncertainty target is met (and a dip
# found); cap on the total measurements, in whole passes (at least one pass).
#
# NVISION_MAX_MEASUREMENTS=2500
#
# Build graphs only for the first N repeats of each combination (later repeats keep their
# metrics and series but get no figures). 0 = every repeat.
#
# NVISION_GRAPH_REPEATS=10
#
# Number of graph-worker processes `nv run` starts. Runners save results right away and queue
# each repeat's plot inputs; a graph worker builds a combination's graphs once all its repeats
# are saved, then archives it. 0 = build graphs inline in the runners (no deferral). Unset
# defaults to half the --runners count (min 1) instead of a fixed number, so a single worker
# doesn't fall behind several runners producing finished repeats -- set this to override.
#
# NVISION_GRAPH_WORKERS=1
#
# Build the per-repeat plots for the SimpleSweep / SimpleSobol strategies (off by default:
# their data, metrics and SBED baselines are kept, only the figures are skipped).
#
# NVISION_PLOT_SWEEP_STRATEGIES=0
#
# Sweep curve-fit early stop: skip remaining starting points once a fit reaches the noise
# floor (reduced chi-square <= 1 + K*sqrt(2/dof)). K in sigmas; 0 disables (race all starts).
# Only active at high peak SNR; low-SNR fits always race every start.
#
# NVISION_SWEEP_FIT_EARLY_STOP_SIGMAS=3.0
#
# Fit-only sweep: the plain SimpleSweep strategies infer with a dip scan and least-squares fits instead
# of the SMC belief (about 2x faster). Nothing is fitted until the dip scan shows a dip; the first fit
# is the full multi-start fit, later ones start from the previous fit. Uncertainty is the fit covariance,
# so sweeps stop later than with the SMC belief, and results are cached apart from the SMC sweep's
# (a full re-run is needed after switching). 1/true/yes enables; default is 0 (SMC sweep).
# NVISION_SWEEP_FIT_ONLY=0
#
# With the fit-only sweep, a warm-started fit runs every this many measurements after the first dip
# (and at the end of every pass over the grid; default is 20)
# NVISION_SWEEP_FIT_EVERY=20

# --- Noise Preset Parameters -------------------------------------------------
#
# Default noise levels for noise tiers
#
# NVISION_NOISE_GAUSS=0.01
# NVISION_NOISE_OVER_PROBE=0.001
#
# Varying Gaussian noise std parameters
# NVISION_NOISE_MAX_GAUSS=0.2
# NVISION_NOISE_GAUSS_STEPS=5

# --- Window/Refocus Parameters -----------------------------------------------
#
# Padding fractions for window inference
#
# NVISION_WINDOW_PADDING_FRAC=0.05
# NVISION_WINDOW_MIN_PADDING_FRAC=0.01

# --- Renamed variables (zero_field_freq / drive_freq / hwhm disambiguation) --------------
#
# The old names are NO LONGER READ; if one is still set (shell or .env) the program refuses to
# start (nvision/tools/renamed_env.py) so a tuned value is never silently dropped. Values and
# units are unchanged -- just rename the key:
#   NVISION_FREQ_CONVERGENCE_THRESHOLD -> NVISION_ZERO_FIELD_FREQ_CONVERGENCE_THRESHOLD
#   NVISION_FREQ_CRLB_SAFETY_FACTOR -> NVISION_ZERO_FIELD_FREQ_CRLB_SAFETY_FACTOR
#   NVISION_NV_CENTER_FREQ_DELTA_HZ -> NVISION_NV_DRIVE_FREQ_DELTA_HZ
#   NVISION_NV_PROBE_DELTA_HZ -> NVISION_NV_DRIVE_FREQ_DELTA_HZ
#   NVISION_SWEEP_FIT_FREQ_STARTS -> NVISION_SWEEP_FIT_ZERO_FIELD_FREQ_STARTS
#   NVISION_CENTER_FREQ_CONVERGENCE_THRESHOLD -> NVISION_ZERO_FIELD_FREQ_CONVERGENCE_THRESHOLD
#   NVISION_CENTER_FREQ_CRLB_SAFETY_FACTOR -> NVISION_ZERO_FIELD_FREQ_CRLB_SAFETY_FACTOR
#   NVISION_SWEEP_FIT_CENTER_FREQ_STARTS -> NVISION_SWEEP_FIT_ZERO_FIELD_FREQ_STARTS
#   NVISION_LINEWIDTH_CONVERGENCE_THRESHOLD -> NVISION_HWHM_CONVERGENCE_THRESHOLD
#   NVISION_HOMOGENEOUS_LINEWIDTH_CONVERGENCE_THRESHOLD -> NVISION_HWHM_LORENTZ_CONVERGENCE_THRESHOLD
#   NVISION_ZEEMAN_SPLIT_CONVERGENCE_THRESHOLD -> NVISION_ZEEMAN_SHIFT_CONVERGENCE_THRESHOLD
#   NVISION_C_TOTAL_CONVERGENCE_THRESHOLD -> NVISION_CONTRAST_TOTAL_CONVERGENCE_THRESHOLD
#   NVISION_DIP_DEPTH_CONVERGENCE_THRESHOLD -> NVISION_CONTRAST_CONVERGENCE_THRESHOLD
#   NVISION_MIN_LINEWIDTH -> NVISION_MIN_HWHM
#   NVISION_MAX_LINEWIDTH -> NVISION_MAX_HWHM
#   NVISION_MIN_SPLIT -> NVISION_MIN_HYPERFINE_SHIFT
#   NVISION_MAX_SPLIT -> NVISION_MAX_HYPERFINE_SHIFT
#   NVISION_NV_GRID_LINEWIDTH -> NVISION_NV_GRID_HWHM
#   NVISION_SIGNAL_LINEWIDTH -> NVISION_SIGNAL_HWHM
# See docs/glossary.md for the vocabulary (drive_freq / candidate_drive_freq / zero_field_freq / zeeman_shift).

# --- NV Center Physical Parameter Bounds ------------------------------------
#
# Physical ranges for k_np, hwhm (HWHM), hyperfine splitting, and
# default frequency sweep window. Shared between the signal generator and
# the inference prior so they can never drift apart.
#
# NVISION_MIN_K_NP=1.0
# NVISION_MAX_K_NP=5.0
# NVISION_MIN_HWHM=200e3
# NVISION_MAX_HWHM=5.0e6
# NVISION_MIN_HYPERFINE_SHIFT=2.0e6
# NVISION_MAX_HYPERFINE_SHIFT=8.5e6

# NV center drive-frequency domain: the upper half [D, D + delta] above the real physical
# zero-field splitting D (~2.87 GHz). The spectrum is mirror-symmetric about D, so the
# lower half would only duplicate information. Delta default (150 MHz) is
# 2.5x MAX_ZEEMAN_SHIFT (nv_center.py) -- a reasonable ~2.1 mT experiment field --
# comfortably clearing hyperfine/hwhm margins for the upper dips.
# NVISION_NV_ZERO_FIELD_SPLITTING_HZ=2.87e9
# NVISION_NV_DRIVE_FREQ_DELTA_HZ=150e6

# SNR x window grid signals only: smallest distance, in total FWHMs, between the upper Zeeman dip and the
# window's lower edge D (zeeman_shift is drawn from [pad, max]), so the dip's left flank is not cut off at D.
# 0.5 = one HWHM (the mirrored lower dip still leaves the edge at ~80% of the dip depth); 1.0 (default) puts
# the left half-maximum inside the window. Changes the draws: re-run voigt-grid after changing it.
# NVISION_NV_ZEEMAN_EDGE_PAD_FWHM=0.5

# Gaussian prior std as a fraction of parameter range (default 0.1 = 1/10 of range)
# NVISION_PRIOR_STD_FRACTION=0.1

# How far (in units of the above prior std) the generator's random draw for a
# parameter's prior *mean* is allowed to land from the true value. Default 3.0
# makes a 2-3 sigma offset the common case (simulating a real experimentalist's
# often-wrong rough calibration guess) instead of the prior mean landing
# suspiciously close to the truth almost every run. Does not change the prior's
# own reported width (still NVISION_PRIOR_STD_FRACTION) -- only where it's centered.
# NVISION_PRIOR_MEAN_OFFSET_SIGMAS=3.0

# Default relative convergence threshold (fraction of bound width; 0.01 = 1%).
# NVISION_CONVERGENCE_THRESHOLD=0.01

# Number of consecutive converged checks required before the SBED locator declares
# convergence and stops. Prevents false early-stop after the first measurement,
# especially with no/low noise where the belief can look spuriously narrow.
# NVISION_CONVERGENCE_PATIENCE=8

# Per-parameter absolute convergence ceilings (physical units). Optional.
# NVISION_ZERO_FIELD_FREQ_CONVERGENCE_THRESHOLD=100000.0
# NVISION_NOISE_SIGMA_CONVERGENCE_THRESHOLD=0.001
# NVISION_K_NP_CONVERGENCE_THRESHOLD=0.04
# NVISION_HWHM_CONVERGENCE_THRESHOLD=
# NVISION_SPLIT_CONVERGENCE_THRESHOLD=
# NVISION_CONTRAST_CONVERGENCE_THRESHOLD=
# NVISION_HWHM_LORENTZ_CONVERGENCE_THRESHOLD=
# NVISION_SIGMA_INHOM_CONVERGENCE_THRESHOLD=

# --- Robust Dip Detection Parameters ------------------------------------------
#
# Family-wise false-alarm probability of the shape-agnostic boxcar dip scan, Bonferroni-corrected
# over every window tested (default is 0.1). Larger values declare the dip, and so start the focus stage,
# earlier at the cost of more false dips on noisy signals.
# NVISION_DIP_P_FA=0.1
#
# The stopping rules re-run the dip scan at most once per this many measurements and reuse the last
# result in between (the scan grows with the number of measurements; default is 10)
# NVISION_DIP_SCAN_EVERY=10

# --- SNR x window study (the voigt-grid run group) ---
# The grid varies one thing per axis. SNR = contrast_total / noise sigma; a run is named SNR(x) and its sigma
# is contrast / x. 1 is the smallest SNR worth running; above ~20 the locators all converge. Comma-separated:
# NVISION_SBED_SNR_VALUES=1,2,5,10,20
# Shared contrast_total of every signal in the study (must lie inside the belief's 0.1-0.4 bounds).
# NVISION_SBED_SNR_CONTRAST=0.25
# Drive-frequency window as multiples of the signal's total FWHM (comma-separated).
# NVISION_SBED_SIGNAL_OCCUPANCY_VALUES=0.5,0.2,0.1,0.05
# The ONE total FWHM (Hz) of every signal in the study, so a window is the same absolute width for every line shape.
# NVISION_SBED_FWHM=2e6
# Gaussian share of that FWHM (0 = pure Lorentzian), at the same total FWHM. Must leave a Lorentzian HWHM >= 200 kHz.
# NVISION_SBED_GAUSSIAN_SHARES=0,0.15,0.3
# The isotope held fixed in the study: unresolved | n14 | n15 (it rescales the per-dip depth, i.e. the SNR).
# NVISION_SBED_STUDY_ISOTOPE=unresolved
# SNR (against NVISION_SBED_SNR_CONTRAST) of the drift study's Gaussian noise.
# NVISION_DRIFT_SNR=40
