# Core Execution Config
NVISION_DEFAULT_REPEATS=5
NVISION_DEFAULT_RUNNERS=6
NVISION_DEFAULT_RUN_ALL=False
NVISION_DEFAULT_LOC_MAX_STEPS=1200
NVISION_DEFAULT_LOC_TIMEOUT_S=1500
NVISION_STREAMING_REPEAT_THRESHOLD=5

# UI & Browser Flags
NVISION_DEFAULT_OPEN_BROWSER=False

# Output & Logs Config
NVISION_DEFAULT_OUT=
NVISION_DEFAULT_LOGS_ROOT=
NVISION_DEFAULT_LOG_LEVEL=INFO

# GCP Integration
NVISION_GCP=False
NVISION_GCP_BUCKET=nvision-artifacts-shoha

# Demo & Beta Specific
NVISION_DEMO_REPEATS=3
NVISION_DEMO_LOC_MAX_STEPS=60
NVISION_DEMO_LOC_TIMEOUT_S=300
NVISION_DEMO_OUT=
NVISION_DEMO_LOGS_ROOT=
NVISION_BETA_OUT=

# GCP Service Account
GOOGLE_APPLICATION_CREDENTIALS=

# SMC Belief Parameters (nvision.belief.smc_marginal)
NVISION_SMC_NUM_PARTICLES=10000         # Number of particles in the filter
NVISION_SMC_ESS_THRESHOLD=0.7           # Effective sample size fraction that triggers resampling
NVISION_SMC_A_PARAM=0.9                # Contraction factor toward mean after nudging (paper default)
NVISION_SMC_POINTS_PER_MIN_FEATURE=5    # Global grid resolution factor
