# Core Execution Config
NVISION_DEFAULT_REPEATS=5
NVISION_DEFAULT_RUNNERS=6
NVISION_DEFAULT_RUN_ALL=False
NVISION_DEFAULT_LOC_MAX_STEPS=1200
NVISION_DEFAULT_LOC_TIMEOUT_S=1500
NVISION_STREAMING_REPEAT_THRESHOLD=5

# UI & Browser Flags
NVISION_DEFAULT_OPEN_BROWSER=False

# Output & Logs Config
NVISION_DEFAULT_OUT=
NVISION_DEFAULT_LOGS_ROOT=
NVISION_DEFAULT_LOG_LEVEL=INFO

# GCP Integration
NVISION_GCP=False
NVISION_GCP_BUCKET=nvision-artifacts-shoha

# Demo & Beta Specific
NVISION_DEMO_REPEATS=3
NVISION_DEMO_LOC_MAX_STEPS=60
NVISION_DEMO_LOC_TIMEOUT_S=300
NVISION_DEMO_OUT=
NVISION_DEMO_LOGS_ROOT=
NVISION_BETA_OUT=

# GCP Service Account
GOOGLE_APPLICATION_CREDENTIALS=

# SMC Belief Parameters (nvision.belief.smc_marginal)
NVISION_SMC_NUM_PARTICLES=10000         # Number of particles in the filter
NVISION_SMC_ESS_THRESHOLD=0.6           # Effective sample size fraction that triggers resampling
NVISION_SMC_A_PARAM=0.91                # Contraction factor toward mean after nudging (paper default)
NVISION_SMC_POINTS_PER_MIN_FEATURE=5    # Global grid resolution factor
NVISION_SMC_MIN_EXPLORATION_FRAC=0.0001   # Minimum parameter variance fraction to prevent particle collapse
NVISION_MIN_STEPS_BEFORE_NARROWING=8      # Minimum steps of global exploration before narrowing bounds
NVISION_SMC_FOCUSING_COVER_FACTOR=3.0     # Multiplier of linewidth for particle active range (k)
NVISION_SMC_FOCUSING_TAIL_PERCENTILE=1.0   # Tail percentile to exclude outliers (alpha)



# Gaussian Mixture Belief Parameters (nvision.belief.gaussian_mixture_marginal)
NVISION_GAUSSIAN_NUM_EXPERTS=7          # Number of Gaussian components (mixture experts)
NVISION_GAUSSIAN_WEIGHT_FLOOR=0.05      # Minimum weight floor during early exploration
NVISION_GAUSSIAN_WEIGHT_FLOOR_STEPS=30  # Steps over which the weight floor decays to zero
NVISION_GAUSSIAN_EPSILON=1e-8           # Base regularisation epsilon for precision matrix inversion

# --- Noise Preset Parameters -------------------------------------------------
# Default noise levels for noise tiers
NVISION_NOISE_MAX_GAUSS=0.01
NVISION_NOISE_GAUSS_STEPS=10

# --- NV Center Physical Parameter Bounds ------------------------------------
#
# Physical ranges for k_np, linewidth (HWHM), hyperfine splitting, and
# default frequency sweep window. Shared between the signal generator and
# the inference prior so they can never drift apart.
#
NVISION_MIN_K_NP=1.0
NVISION_MAX_K_NP=5.0
NVISION_MIN_LINEWIDTH=200e3
NVISION_MAX_LINEWIDTH=5.0e6
NVISION_MIN_SPLIT=5.0e6
NVISION_MAX_SPLIT=8.5e6
NVISION_NV_CENTER_FREQ_X_MIN=2.6e9
NVISION_NV_CENTER_FREQ_X_MAX=3.1e9

# Default relative convergence threshold (fraction of bound width; 0.01 = 1%).
NVISION_CONVERGENCE_THRESHOLD=0.01

# Per-parameter absolute convergence ceilings (physical units). Optional; unset
# params use NVISION_CONVERGENCE_THRESHOLD × bound width.
# Frequency (Hz). Default is 100 KHz.
NVISION_FREQ_CONVERGENCE_THRESHOLD=100000.0
# k_np (dimensionless). Example: 0.04 ≈ 1% of default range [1, 5].
NVISION_K_NP_CONVERGENCE_THRESHOLD=0.1

# Gaussian prior std as a fraction of parameter range (default 0.1 = 1/10 of range)
NVISION_PRIOR_STD_FRACTION=0.1

# Robust Dip Detection Parameters
NVISION_DIP_N_SIGMA=3.0
NVISION_DIP_MIN_CLUSTER=2
NVISION_DIP_NOISE_UNCERTAINTY_THRESHOLD=0.15
NVISION_DIP_CONFIDENCE=0.99



NVISION_SMC_MAX_CANDIDATES=10000
NVISION_MIN_RUNNERS=2
NVISION_SBED_STEPS_FRACTION=0.5